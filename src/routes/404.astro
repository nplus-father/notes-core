---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { withBase } from "../lib/url";
import { site } from "virtual:notes-core/site";
---

<BaseLayout title={`Not found · ${site.brand}`} site={site} noindex>
  <section class="nf grid-12" aria-labelledby="nf-h">
    <p class="nf-num" aria-hidden="true">404</p>
    <div class="nf-body">
      <p class="nf-kicker label"><span class="seal" aria-hidden="true"></span>Not found</p>
      <h1 class="nf-title" id="nf-h">這一頁不在書裡，可能是網址打錯了，或它已經換了位置。</h1>
      <a class="nf-home arrow-nudge" href={withBase("/")}>
        <span class="nf-home-text">Back to {site.brand}</span>
        <Icon name="arrow-right" size={20} />
      </a>
    </div>
  </section>
</BaseLayout>
