---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { withBase } from "../lib/url";
import { site, bibliography } from "virtual:notes-core/site";
import { getCollection } from "astro:content";

const hasGuide = (await getCollection("guide")).length > 0;
const hasConcepts = (await getCollection("concepts")).length > 0;
const hasLibrary = (bibliography as unknown[]).length > 0;
const conceptLabel = site.conceptLabelEn ?? "Concepts";
const suggestions = [
  hasGuide && { href: withBase("guide/"), label: "Guide" },
  hasConcepts && { href: withBase("concepts/"), label: conceptLabel },
  hasLibrary && { href: withBase("library/"), label: "Library" },
].filter(Boolean) as { href: string; label: string }[];
---

<BaseLayout title={`Not found · ${site.brand}`} site={site} noindex>
  <section class="nf grid-12" aria-labelledby="nf-h">
    <p class="nf-num" aria-hidden="true">404</p>
    <div class="nf-body">
      <p class="nf-kicker label"><span class="seal" aria-hidden="true"></span>Not found</p>
      <h1 class="nf-title" id="nf-h">這一頁不在書裡，可能是網址打錯了，或它已經換了位置。</h1>
      <form class="nf-search" action={withBase("search/")} method="get" role="search">
        <label class="nf-search-label label" for="nf-q">Search this station</label>
        <div class="nf-search-row">
          <input
            id="nf-q"
            name="q"
            type="search"
            autocomplete="off"
            placeholder={site.searchPlaceholder ?? "Search notes…"}
          />
          <button type="submit" class="nf-search-go">
            <span>Search</span>
            <Icon name="arrow-right" size={18} />
          </button>
        </div>
      </form>
      <nav class="nf-links" aria-label="Suggestions">
        {
          suggestions.map((l) => (
            <a class="link-draw" href={l.href}>
              {l.label}
            </a>
          ))
        }
        <a class="nf-home" href={withBase("/")}>
          <span class="nf-home-text">Back to {site.brand}</span>
          <Icon name="arrow-right" size={18} />
        </a>
      </nav>
    </div>
  </section>
</BaseLayout>
