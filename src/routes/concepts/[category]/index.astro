---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ConceptCard from "../../../components/ConceptCard.astro";
import Crumbs from "../../../components/Crumbs.astro";
import { siteUrl, siteLabel } from "../../../lib/links";
import { byImportance } from "../../../lib/collections";
import { site } from "virtual:notes-core/site";
import { getCategories } from "../../../lib/nav-data";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const concepts = await getCollection("concepts");
  const { categories } = await getCategories();
  return categories.map((c: any) => ({
    params: { category: c.slug },
    props: {
      category: c,
      items: concepts.filter((p) => p.data.category === c.slug).sort(byImportance),
    },
  }));
}

const { category, items } = Astro.props;
const conceptLabel = site.conceptLabelEn ?? "Concepts";
---

<BaseLayout title={`${category.name} · ${conceptLabel}`} site={site}>
  <Crumbs
    site={site}
    items={[
      { label: conceptLabel, href: "/concepts/" },
      { label: category.name, icon: category.icon },
    ]}
  />
  <header class="page-head">
    <h1>{category.icon} {category.name}</h1>
    <p class="lede">{category.intro}</p>
    <p class="muted">
      {items.length} pages
      {
        category.sister && (
          <>
            {" "}
            · Dive deeper → <a href={siteUrl(category.sister)}>{siteLabel(category.sister)}</a>
          </>
        )
      }
    </p>
  </header>

  {
    items.length > 0 ? (
      <section class="card-grid">
        {items.map((entry: any) => (
          <ConceptCard entry={entry} />
        ))}
      </section>
    ) : (
      <p class="empty">No pages in this category yet.</p>
    )
  }
</BaseLayout>
