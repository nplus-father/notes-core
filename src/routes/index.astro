---
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import Bookshelf from "../components/Bookshelf.astro";
import SchoolsMap from "../components/SchoolsMap.astro";
import AuthorProfile from "../components/AuthorProfile.astro";
import Overview from "../components/Overview.astro";
import { withBase } from "../lib/url";
import { shelfFromBibliography, normalizeSchools } from "../lib/library";
import { siteBySlug, topicSites, personSites } from "../lib/sites";
import { site, books, bibliography, schools, profile, overview } from "virtual:notes-core/site";

// 首頁由上而下：hero → 總覽 → 思想側寫（人物站）／學派地圖（主題站）→ 參考書架。
// 總覽排在最前（v0.29.0）：先用一段散文讀懂「這是什麼」，再往下看結構化的卡片與表格；
// 反過來的話，讀者得自己從卡片拼出全貌，而那正是總覽要代勞的事。
// 藏書盤點自 v0.30.0 遷往 /library/——收藏狀態是工作文件（採購 roadmap），不是門面；
// 首頁書架保留（owned 封面牆是「這站有多少料」最直觀的證明），入口連過去。
// 導覽入口卡於 v0.31.0 移除（Andrew 裁定）——導覽動線交給 topnav 的 📖，首頁不重複目錄。
// 總覽／導覽／側寫／地圖皆為選配，依站台是否提供資料決定；概念入口走 topnav 的 Concepts，
// 不在首頁重複分類格——避免與 /concepts/ 學習路徑頁重覆。
// 書架：站台給了 bibliography 就自動取其中 owned 項（單一資料源），不必再維護 books.ts。
// prose config 可用 {base} 代表站台 base 前綴（withBase("/")）。
const heroLede = (site.heroLede ?? "").replaceAll("{base}", withBase("/"));
const shelf = bibliography.length > 0 ? shelfFromBibliography(bibliography) : books;
// 舊 schools.ts（純 array）與新 defineSchools 物件形式兩收，歸一後交給 SchoolsMap。
const schoolsData = normalizeSchools(schools);

// Hero（v0.36.0）：直式站封面（portal 同一張 public/cover.png——人物站＝傳主肖像、
// 主題站＝印刷風設計圖）＋扉頁排版攤成活字。先前的橫式 site-cover.svg 是「用圖片印
// 出來的文字」，且內容與旁邊的 h1 / heroLede 逐字重複；讀者在 portal 憑直式封面挑站，
// 點進來卻再也看不到那張圖——身分交接斷了。排版元素（眉標／襯線大字／短橫線／寬字距
// 副題）全數保留，但改成可選取、吃深淺色主題的 HTML；圖那格只放文字做不到的事。
const slug = import.meta.env.BASE_URL.replace(/^\/|\/$/g, "") || "";
const entry = siteBySlug.get(slug);
const axis = entry?.axis ?? "topic";
// 主標＝registry 的 label（主題站＝中文短名、人物站＝該人物通行的寫法）；brand 退為
// 寬字距副題——與封面的主從一致。registry 查不到就退回站台 titleBase。
const heading = entry?.label ?? site.titleBase ?? site.brand;
// 同軸內編號——新站 append 在該軸尾端，既有編號因此穩定（沿退役的 site-cover.svg 編法）。
const pool = axis === "person" ? personSites : topicSites;
const idx = pool.findIndex((s) => s.slug === slug);
const serial = idx >= 0 ? String(idx + 1).padStart(2, "0") : "";
// 建置期檢查 public/cover.png 是否存在（astro build 的 cwd＝站台根目錄）——
// 沒有封面的站（如剛開的新站）hero 純文字呈現，不出破圖。
const hasCover = existsSync(resolve("public/cover.png"));
---

<BaseLayout title={site.tagline ? `${site.brand} · ${site.tagline}` : site.brand} site={site}>
  <header class="home-hero">
    {
      hasCover && (
        <img
          class="hero-cover"
          src={withBase("cover.png")}
          alt={heading}
          width="900"
          height="1200"
          fetchpriority="high"
        />
      )
    }
    <div class="home-hero-body">
      <p class="hero-kicker">
        {axis === "person" ? "人物" : "主題"}{serial && <span class="hero-serial">N°{serial}</span>}
      </p>
      <h1>{heading}</h1>
      <span class="hero-rule" aria-hidden="true"></span>
      <p class="hero-brand">{site.brand}</p>
      {heroLede && <p class="lede" set:html={heroLede} />}
    </div>
  </header>

  <Overview overview={overview} />
  {profile && <AuthorProfile profile={profile} bibliography={bibliography} />}
  <SchoolsMap schools={schoolsData} />
  <Bookshelf books={shelf} moreHref={bibliography.length > 0 ? withBase("library/") : undefined} />
</BaseLayout>
