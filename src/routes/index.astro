---
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Bookshelf from "../components/Bookshelf.astro";
import SchoolsMap from "../components/SchoolsMap.astro";
import AuthorProfile from "../components/AuthorProfile.astro";
import Overview from "../components/Overview.astro";
import { withBase } from "../lib/url";
import { tightenPunct } from "../lib/punct";
import { shelfFromBibliography, normalizeSchools } from "../lib/library";
import { siteBySlug, topicSites, personSites } from "../lib/sites";
import { coverPlateFor, clothFor } from "../lib/cover-plate.ts";
import { motifSvg } from "../lib/motifs.ts";
import { site, books, bibliography, schools, profile, overview } from "virtual:notes-core/site";

const heroLede = tightenPunct((site.heroLede ?? "").replaceAll("{base}", withBase("/")));
const shelf = bibliography.length > 0 ? shelfFromBibliography(bibliography) : books;
const schoolsData = normalizeSchools(schools);

const slug = import.meta.env.BASE_URL.replace(/^\/|\/$/g, "") || "";
const entry = siteBySlug.get(slug);
const axis = entry?.axis ?? "topic";
const heading = entry?.label ?? site.titleBase ?? site.brand;
const headingIsLatin = /^[\p{Script=Latin}\p{N}\s.,'’&\-]+$/u.test(heading);
const titleScale = (() => {
  if (headingIsLatin) {
    const n = heading.length;
    return n <= 8 ? 1.35 : n <= 11 ? 1.2 : n <= 14 ? 1.1 : 1;
  }
  const n = [...heading.replace(/\s/g, "")].length;
  return n <= 2 ? 1.9 : n === 3 ? 1.5 : n === 4 ? 1.25 : 1;
})();
const pool = axis === "person" ? personSites : topicSites;
const idx = pool.findIndex((s) => s.slug === slug);
const serial = idx >= 0 ? String(idx + 1).padStart(2, "0") : "";
const plate = coverPlateFor(slug);
const cloth = clothFor(slug);
const hasPortrait = axis === "person" && existsSync(resolve("public/cover.png"));
const foilName = plate?.en ?? site.brand.replace(/\s*Notes$/, "");
const foilLegend = plate?.legend ?? (hasPortrait ? "Portrait" : "");

const concepts = await getCollection("concepts");
const categories = await getCollection("categories");
const problems = site.hasProblems ? await getCollection("problems") : [];
const guide = await getCollection("guide");
const pages = concepts.length + problems.length;
const dates = [
  overview?.writtenAt,
  site.curation?.checkedAt,
  site.curation?.enrichedAt,
  ...guide.map((g) => (g.data as { writtenAt?: string }).writtenAt),
].filter((d): d is string => typeof d === "string" && /^\d{4}-\d{2}-\d{2}$/.test(d));
const updated = dates.sort().at(-1);
const stats = [
  pages > 0 && { n: String(pages), label: pages === 1 ? "Page" : "Pages" },
  categories.length > 0 && {
    n: String(categories.length),
    label: categories.length === 1 ? "Category" : "Categories",
  },
  shelf.length > 0 && { n: String(shelf.length), label: shelf.length === 1 ? "Book" : "Books" },
].filter(Boolean) as { n: string; label: string }[];

const hasOverview = !!overview && overview.sections.length > 0;
const hasSchools = schoolsData.entries.length > 0;
let counter = 0;
const next = () => String(++counter).padStart(2, "0");
const nums = {
  overview: hasOverview ? next() : "",
  profile: profile
    ? {
        thesis: next(),
        contributions: profile.contributions.length > 0 ? next() : "",
        readingPath: (profile.readingPath ?? []).length > 0 ? next() : "",
        influences: (profile.influences ?? []).length > 0 ? next() : "",
      }
    : null,
  schools: hasSchools ? next() : "",
  sources: shelf.length > 0 ? next() : "",
};
---

<BaseLayout
  title={site.tagline ? `${site.brand} · ${site.tagline}` : site.brand}
  site={site}
  themeColor={cloth}
>
  <header
    class:list={[
      "hero",
      "grid-12",
      {
        "has-cloth": !!cloth,
        "has-motif": !!plate,
        "has-portrait": hasPortrait,
        "has-serial": !!serial,
      },
    ]}
  >
    <div class="hero-text">
      <p class="hero-kicker">
        <span class="seal" aria-hidden="true"></span>
        <span>{axis === "person" ? "Person" : "Topic"}</span>
        {serial && <span class="hero-serial">N°{serial}</span>}
      </p>
      <h1
        class="hero-title"
        lang={headingIsLatin ? "en" : undefined}
        style={titleScale === 1 ? undefined : `--title-scale: ${titleScale}`}
      >
        <span class="hero-title-inner">{heading}</span>
      </h1>
      <span class="hero-rule" aria-hidden="true"></span>
      <p class="hero-brand" lang="en">{site.brand}</p>
      {heroLede && <p class="hero-lede" set:html={heroLede} />}
    </div>
    {
      cloth && (
        <div class="hero-cloth">
          <figure
            class="hero-volume"
            role={plate ? "img" : undefined}
            aria-label={plate ? `${plate.title}：${plate.legend}` : undefined}
          >
            <figcaption class="hero-foil" lang="en" aria-hidden="true">
              <span class="hero-foil-name">{foilName}</span>
              {foilLegend && <span class="hero-foil-legend">{foilLegend}</span>}
              <span class="hero-foil-pl">Pl. I</span>
            </figcaption>
            <div class="hero-art">
              {plate && (
                <span
                  class="hero-motif"
                  set:html={motifSvg(plate.motif, {
                    className: "hero-motif-svg",
                    stroke: 1.6,
                    fit: true,
                    stamp: true,
                  })}
                />
              )}
              {hasPortrait && (
                <span class="hero-portrait">
                  <img
                    src={withBase("cover.png")}
                    alt=""
                    width="900"
                    height="1200"
                    fetchpriority="high"
                    decoding="async"
                  />
                </span>
              )}
            </div>
            <div class="hero-volume-foot" aria-hidden="true">
              {serial && <span class="hero-numeral">N°{serial}</span>}
            </div>
          </figure>
          {updated && (
            <p class="hero-cloth-foot">
              <span>Updated</span>
              <time datetime={updated}>{updated}</time>
            </p>
          )}
        </div>
      )
    }
    {
      (stats.length > 0 || updated) && (
        <dl class="hero-stats">
          {stats.map((s) => (
            <div class="hero-stat">
              <dt>{s.label}</dt>
              <dd>{s.n}</dd>
            </div>
          ))}
          {updated && (
            <div class="hero-stat is-date">
              <dt>Updated</dt>
              <dd>
                <time datetime={updated}>{updated}</time>
              </dd>
            </div>
          )}
        </dl>
      )
    }
  </header>

  {hasOverview && <Overview overview={overview} num={nums.overview} />}
  {
    profile && nums.profile && (
      <AuthorProfile profile={profile} bibliography={bibliography} nums={nums.profile} />
    )
  }
  {hasSchools && <SchoolsMap schools={schoolsData} num={nums.schools} />}
  {
    shelf.length > 0 && (
      <Bookshelf
        books={shelf}
        num={nums.sources}
        moreHref={bibliography.length > 0 ? withBase("library/") : undefined}
      />
    )
  }
</BaseLayout>

<script>
  document.addEventListener(
    "error",
    (e) => {
      const img = e.target;
      if (!(img instanceof HTMLImageElement) || !img.classList.contains("cover-img")) return;
      const fallback = img.dataset.fallback;
      if (!fallback || img.src === fallback) return;
      img.src = fallback;
      delete img.dataset.fallback;
    },
    true,
  );
</script>
