---
import BaseLayout from "../layouts/BaseLayout.astro";
import Crumbs from "../components/Crumbs.astro";
import Icon from "../components/Icon.astro";
import { withBase } from "../lib/url";
import { bareSlug } from "../lib/collections";
import { pad2, latinLang } from "../lib/toc";
import { site } from "virtual:notes-core/site";
import { getCategories } from "../lib/nav-data";
import { getCollection } from "astro:content";

const concepts = await getCollection("concepts");
const { categories } = await getCategories();

const writtenByCat = new Map<string, Map<string, (typeof concepts)[number]>>();
for (const c of concepts) {
  const cat = c.data.category;
  if (!writtenByCat.has(cat)) writtenByCat.set(cat, new Map());
  writtenByCat.get(cat)!.set(bareSlug(c.id), c);
}

const groups = categories
  .map((cat) => ({
    cat,
    items: (cat.mastery ?? []).map((m, i) => {
      const entry = m.slug ? writtenByCat.get(cat.slug)?.get(m.slug) : undefined;
      return {
        key: `${cat.slug}:${i}`,
        text: m.text,
        href: entry ? withBase(`concepts/${entry.id}/`) : null,
      };
    }),
  }))
  .filter((g) => g.items.length > 0);
const total = groups.reduce((n, g) => n + g.items.length, 0);

const storeKey = `check:${import.meta.env.BASE_URL}`;
---

<BaseLayout title={`Check · ${site.brand}`} site={site} noindex={total === 0}>
  <Crumbs site={site} items={[{ label: "Check" }]} />
  <header class="page-head idx-head check-head section">
    <p class="idx-side running-head"><span class="running-head-num">00</span>Mastery</p>
    <div class="idx-main">
      <h1 class="idx-title check-title" lang="en">Check</h1>
      {
        total > 0 && (
          <>
            <p class="check-figure" aria-live="polite">
              <span class="check-done" data-total-done>
                0
              </span>
              <span class="check-sep" aria-hidden="true">
                /
              </span>
              <span class="check-of">
                <span class="visually-hidden">of</span>
                {total}
              </span>
              <span class="check-unit">Mastered</span>
            </p>
            <div class="check-line" aria-hidden="true">
              <i data-total-line />
            </div>
          </>
        )
      }
    </div>
  </header>

  {
    total === 0 && (
      <section class="section idx-list">
        <p class="running-head">
          <span class="running-head-num">01</span>Empty
        </p>
        <p class="section-body idx-empty">這一站還沒有檢核清單。</p>
      </section>
    )
  }

  {
    total > 0 && (
      <div class="toc check-toc bleed">
        {groups.map(({ cat, items }, gi) => (
          <section class="toc-ch check-ch reveal" data-cat aria-labelledby={`ck-${cat.slug}`}>
            <div class="toc-side">
              <span class="toc-num" aria-hidden="true">
                {pad2(gi + 1)}
              </span>
              <h2 class="toc-name" id={`ck-${cat.slug}`} lang={latinLang(cat.name)}>
                {cat.name}
              </h2>
              <p class="toc-progress">
                <span class="toc-count" data-cat-prog>
                  0<span class="toc-slash">/</span>
                  {items.length}
                </span>
                <span class="toc-meter" aria-hidden="true">
                  <i data-cat-line style="--p:0" />
                </span>
              </p>
            </div>
            <ul class="check-list">
              {items.map((it) => (
                <li class="check-item">
                  <input class="check-box" type="checkbox" id={it.key} data-check-key={it.key} />
                  <label class="check-text" for={it.key}>
                    {it.text}
                  </label>
                  {it.href ? (
                    <a
                      class="check-review arrow-nudge"
                      href={it.href}
                      aria-label={`Review: ${it.text}`}
                    >
                      Review
                      <Icon name="arrow-right" size={14} />
                    </a>
                  ) : (
                    <span class="check-review is-none" aria-hidden="true">
                      —
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    )
  }

  <script is:inline define:vars={{ storeKey }}>
    const boxes = [...document.querySelectorAll("input[data-check-key]")];
    let saved = [];
    try {
      saved = JSON.parse(localStorage.getItem(storeKey) || "[]");
    } catch {
      saved = [];
    }
    const on = new Set(saved);
    for (const b of boxes) b.checked = on.has(b.dataset.checkKey);
    const update = () => {
      for (const sec of document.querySelectorAll("[data-cat]")) {
        const all = sec.querySelectorAll("input[data-check-key]").length;
        const done = sec.querySelectorAll("input[data-check-key]:checked").length;
        const prog = sec.querySelector("[data-cat-prog]");
        prog.firstChild.textContent = String(done);
        sec.querySelector("[data-cat-line]").style.setProperty("--p", all ? done / all : 0);
        sec.classList.toggle("is-complete", all > 0 && done === all);
      }
      const done = boxes.filter((b) => b.checked).length;
      const doneEl = document.querySelector("[data-total-done]");
      if (doneEl) doneEl.textContent = String(done);
      const line = document.querySelector("[data-total-line]");
      if (line) line.style.setProperty("--p", boxes.length ? done / boxes.length : 0);
    };
    document.addEventListener("change", (e) => {
      const t = e.target;
      if (!(t instanceof HTMLInputElement) || !t.dataset.checkKey) return;
      const checked = boxes.filter((b) => b.checked).map((b) => b.dataset.checkKey);
      try {
        localStorage.setItem(storeKey, JSON.stringify(checked));
      } catch {}
      update();
    });
    update();
  </script>
</BaseLayout>
