---
import BaseLayout from "../layouts/BaseLayout.astro";
import Crumbs from "../components/Crumbs.astro";
import FurtherReading from "../components/FurtherReading.astro";
import ReadingScripts from "../components/ReadingScripts.astro";
import Contents from "../components/Contents.astro";
import { splitTitle } from "../lib/reading";
import { stripEmoji } from "../lib/site-config";
import { site } from "virtual:notes-core/site";
import { getCollection, render } from "astro:content";

const entries = (await getCollection("guide")).sort((a, b) => a.id.localeCompare(b.id));
const chapters = await Promise.all(
  entries.map(async (entry) => {
    const { Content, headings, remarkPluginFrontmatter } = await render(entry);
    const slug = entry.id.replace(/^guide\//, "");
    const toc = headings
      .filter((h) => h.depth === 2 && h.slug !== "footnote-label")
      .map((h) => ({ slug: h.slug, text: splitTitle(stripEmoji(h.text)).main }));
    return {
      entry,
      Content,
      slug,
      toc,
      standfirst: remarkPluginFrontmatter?.standfirst as string,
    };
  })
);

const shortTitle = (t: string) => t.split("：")[0];
const tabLabel = (c: (typeof chapters)[number]) =>
  c.entry.data.tab ?? shortTitle(c.entry.data.title);
const num = (i: number) => String(i + 1).padStart(2, "0");

const writtenAt = chapters.reduce<string>(
  (acc, c) => (c.entry.data.writtenAt > acc ? c.entry.data.writtenAt : acc),
  ""
);
const description = chapters[0]?.standfirst;
---

<BaseLayout
  title={`Guide · ${site.brand}`}
  site={site}
  noindex={chapters.length === 0}
  description={description}
  progress={chapters.length > 0}
>
  <Crumbs site={site} items={[{ label: "Guide" }]} />
  <div class="guide bleed">
    <header class="page-head guide-head">
      <h1 lang="en">Guide</h1>
      {
        writtenAt && (
          <p class="guide-stamp running-head" title="這份導覽依當時的站況寫成">
            <span>Written</span>
            <time datetime={writtenAt}>{writtenAt}</time>
          </p>
        )
      }
    </header>

    {
      chapters.length === 0 && (
        <p class="guide-empty">
          這一站還沒有導覽——用 /note-guide 產出 src/content/guide/ 的章節後，這裡就會長出來。
        </p>
      )
    }

    {
      chapters.length > 0 && (
        <>
          <div class="guide-tabs">
            <div class="guide-tabs-inner" role="tablist" aria-label="Chapters">
              {chapters.map((c, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`tab-${c.slug}`}
                  class={`guide-tab${i === 0 ? " is-active" : ""}`}
                  aria-selected={i === 0 ? "true" : "false"}
                  aria-controls={c.slug}
                  tabindex={i === 0 ? 0 : -1}
                  data-ch={c.slug}
                >
                  <span class="guide-tab-num">{num(i)}</span>
                  <span class="guide-tab-text">{tabLabel(c)}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="guide-chapters">
            {chapters.map((c, i) => (
              <article
                id={c.slug}
                class="guide-chapter"
                data-ch={c.slug}
                hidden={i === 0 ? undefined : "until-found"}
              >
                <aside class="guide-rail" aria-label={`Chapter ${num(i)}`}>
                  <p class="guide-rail-head running-head">
                    <span class="running-head-num">{num(i)}</span>
                    <span>{tabLabel(c)}</span>
                  </p>
                  {c.entry.data.writtenAt && (
                    <p class="guide-rail-date">
                      <span class="mg-label">Written</span>
                      <time datetime={c.entry.data.writtenAt}>{c.entry.data.writtenAt}</time>
                    </p>
                  )}
                  <Contents items={c.toc} />
                </aside>
                <div class="guide-chapter-main">
                  <h2 class="guide-title">{c.entry.data.title}</h2>
                  <div class="guide-body prose">
                    <c.Content />
                  </div>
                  <FurtherReading items={c.entry.data.furtherReading} level={3} />
                </div>
              </article>
            ))}
          </div>

          <noscript>
            <style>
              .guide-tabs {
                display: none;
              }
              .guide-chapter[hidden] {
                display: grid;
                content-visibility: visible;
                margin-top: var(--space-section);
                border-top: 1px solid var(--ink);
                padding-top: 1.5rem;
              }
            </style>
          </noscript>
        </>
      )
    }
  </div>
  <ReadingScripts />
</BaseLayout>

<script>
  const bar = document.querySelector<HTMLElement>(".guide-tabs");
  const tabs = [...document.querySelectorAll<HTMLButtonElement>(".guide-tab")];
  const chapters = [...document.querySelectorAll<HTMLElement>(".guide-chapter")];
  if (bar && tabs.length > 0) {
    for (const c of chapters) {
      c.setAttribute("role", "tabpanel");
      c.setAttribute("aria-labelledby", `tab-${c.dataset.ch}`);
    }

    const activate = (ch: string) => {
      if (!chapters.some((c) => c.dataset.ch === ch)) return false;
      for (const t of tabs) {
        const on = t.dataset.ch === ch;
        t.classList.toggle("is-active", on);
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
      }
      for (const c of chapters) {
        if (c.dataset.ch === ch) c.removeAttribute("hidden");
        else c.setAttribute("hidden", "until-found");
      }
      return true;
    };

    const go = (t: HTMLButtonElement, scroll: boolean) => {
      const ch = t.dataset.ch ?? "";
      if (!activate(ch)) return;
      history.replaceState(null, "", `#${ch}`);
      if (scroll && bar.getBoundingClientRect().top <= parseFloat(getComputedStyle(bar).top) + 1)
        document.getElementById(ch)?.scrollIntoView();
    };

    for (const t of tabs) {
      t.addEventListener("click", () => go(t, true));
      t.addEventListener("keydown", (e) => {
        const i = tabs.indexOf(t);
        const to =
          e.key === "ArrowRight"
            ? tabs[(i + 1) % tabs.length]
            : e.key === "ArrowLeft"
              ? tabs[(i - 1 + tabs.length) % tabs.length]
              : e.key === "Home"
                ? tabs[0]
                : e.key === "End"
                  ? tabs[tabs.length - 1]
                  : null;
        if (!to) return;
        e.preventDefault();
        to.focus();
        go(to, false);
      });
    }
    for (const c of chapters)
      c.addEventListener("beforematch", () => activate(c.dataset.ch ?? ""));
    addEventListener("hashchange", () => activate(location.hash.slice(1)));
    if (location.hash) activate(location.hash.slice(1));
  }
</script>
