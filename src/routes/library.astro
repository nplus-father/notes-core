---
import BaseLayout from "../layouts/BaseLayout.astro";
import Crumbs from "../components/Crumbs.astro";
import Bibliography from "../components/Bibliography.astro";
import { bookUrl, bookCoverUrl, siteUrl, siteLabel } from "../lib/links";
import { TIER_META, authorKey, type BibliographyEntry } from "../lib/library";
import { pad2 } from "../lib/toc";
import { site, bibliography } from "virtual:notes-core/site";
import { getCollection } from "astro:content";

const entries = bibliography as BibliographyEntry[];

const concepts = await getCollection("concepts");
const problems = site.hasProblems ? await getCollection("problems") : [];
const refCount = new Map<string, number>();
for (const page of [...concepts, ...problems]) {
  for (const fr of page.data.furtherReading) {
    refCount.set(fr.book, (refCount.get(fr.book) ?? 0) + 1);
  }
}

const owned = entries.filter((e) => e.status === "owned");
const rows = owned
  .map((e) => ({ e, n: e.slug ? (refCount.get(e.slug) ?? 0) : 0 }))
  .sort((a, b) => b.n - a.n);
const dug = rows.filter((r) => r.n > 0);
const undug = rows.filter((r) => r.n === 0);
const debt = undug.filter((r) => !r.e.tier || r.e.tier === "spine");
const spineDebt = debt.filter((r) => r.e.tier === "spine");
const excused = undug.filter((r) => r.e.tier && r.e.tier !== "spine");

const EXCUSED_TIERS = ["support", "tool", "delegated"] as const;
const excusedGroups = EXCUSED_TIERS.map((tier) => ({
  tier,
  meta: TIER_META[tier],
  books: excused.filter((r) => r.e.tier === tier),
})).filter((g) => g.books.length > 0);

const delegatedBy = new Map<string, number>();
for (const r of excused) {
  if (r.e.tier === "delegated" && r.e.delegatedTo) {
    delegatedBy.set(r.e.delegatedTo, (delegatedBy.get(r.e.delegatedTo) ?? 0) + 1);
  }
}
const delegatedChips = [...delegatedBy.entries()].sort((a, b) => b[1] - a[1]);

const byAuthor = new Map<string, { author: string; books: typeof excused }>();
for (const r of excused) {
  const key = authorKey(r.e.author);
  if (!key) continue;
  const cur = byAuthor.get(key);
  if (cur) cur.books.push(r);
  else byAuthor.set(key, { author: r.e.author ?? key, books: [r] });
}
const authorClusters = [...byAuthor.values()]
  .filter((c) => c.books.length >= 2)
  .map((c) => ({
    author: c.books
      .map((r) => (r.e.author ?? "").split(/\s+with\s+|\s*&\s*|\s*\(|\s*（/)[0].trim())
      .reduce((a, b) => (b.length > a.length ? b : a), ""),
    books: c.books
      .slice()
      .sort(
        (a, b) =>
          EXCUSED_TIERS.indexOf(a.e.tier as (typeof EXCUSED_TIERS)[number]) -
          EXCUSED_TIERS.indexOf(b.e.tier as (typeof EXCUSED_TIERS)[number])
      ),
  }))
  .sort((a, b) => b.books.length - a.books.length);

const showClusters =
  authorClusters.length >= 2 ||
  (authorClusters.length === 1 && authorClusters[0].books.length * 2 < excused.length);
const peak = Math.max(1, ...dug.map((r) => r.n));
const totalRefs = dug.reduce((s, r) => s + r.n, 0);
const showMining = owned.length >= 4;

const VISIBLE_ROWS = 16;
const shownRows = dug.length > VISIBLE_ROWS + 4 ? dug.slice(0, VISIBLE_ROWS) : dug;
const moreRows = dug.slice(shownRows.length);
const step = peak <= 4 ? 1 : peak <= 10 ? 2 : peak <= 25 ? 5 : peak <= 50 ? 10 : 20;
const ticks: number[] = [];
for (let v = 0; v <= peak; v += step) ticks.push(v);

const stats = [
  { label: "Listed", n: entries.length },
  { label: "Owned", n: owned.length },
  ...(showMining
    ? [
        { label: "Mined", n: dug.length },
        { label: "Unmined", n: debt.length },
        { label: "Citations", n: totalRefs },
      ]
    : []),
  ...(showMining && excused.length > 0 ? [{ label: "Exempt", n: excused.length }] : []),
];
---

<BaseLayout title={`Library · ${site.brand}`} site={site} noindex={entries.length === 0}>
  <Crumbs site={site} items={[{ label: "Library" }]} />
  <header class="page-head idx-head lib-head section">
    <p class="idx-side running-head"><span class="running-head-num">00</span>Holdings</p>
    <div class="idx-main">
      <h1 class="idx-title" lang="en">Library</h1>
      {
        entries.length > 0 && (
          <dl class="lib-stats">
            {stats.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd>{s.n}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </header>

  {
    entries.length === 0 && (
      <section class="section idx-list">
        <p class="running-head">
          <span class="running-head-num">01</span>Empty
        </p>
        <p class="section-body idx-empty">這一站還沒有藏書盤點。</p>
      </section>
    )
  }

  {
    showMining && (
      <section class="section lib-sec cov reveal" aria-labelledby="cov-h">
        <h2 class="running-head" id="cov-h">
          <span class="running-head-num">01</span>Coverage
        </h2>
        <div class="section-body">
          {dug.length > 0 && (
            <div class="cov-chart">
              <ol class="cov-rows">
                {shownRows.map((r) => (
                  <li class="cov-row">
                    <span class="cov-label" title={r.e.title}>
                      {r.e.title}
                    </span>
                    <span class="cov-track" aria-hidden="true">
                      <i style={`--w:${r.n / peak}`} />
                    </span>
                    <span class="cov-n">
                      {r.n}
                      <span class="visually-hidden"> pages</span>
                    </span>
                  </li>
                ))}
              </ol>
              {moreRows.length > 0 && (
                <details class="cov-more">
                  <summary>
                    <span class="cov-more-sign" aria-hidden="true" />
                    {moreRows.length} more
                  </summary>
                  <ol class="cov-rows" start={shownRows.length + 1}>
                    {moreRows.map((r) => (
                      <li class="cov-row">
                        <span class="cov-label" title={r.e.title}>
                          {r.e.title}
                        </span>
                        <span class="cov-track" aria-hidden="true">
                          <i style={`--w:${r.n / peak}`} />
                        </span>
                        <span class="cov-n">
                          {r.n}
                          <span class="visually-hidden"> pages</span>
                        </span>
                      </li>
                    ))}
                  </ol>
                </details>
              )}
              <div class="cov-axis" aria-hidden="true">
                <span class="cov-axis-label">Pages citing</span>
                <span class="cov-axis-scale">
                  {ticks.map((v) => (
                    <span style={`--x:${v / peak}`}>{v}</span>
                  ))}
                </span>
              </div>
            </div>
          )}

          {debt.length > 0 && (
            <div class="cov-block">
              <h3 class="cov-block-h">
                <span class="label">Unmined</span>
                <span class="cov-block-n">{debt.length}</span>
              </h3>
              <p class="cov-block-note">
                已收進書庫，但還沒有任何筆記頁引用——下一輪深化的現成材料
                {spineDebt.length > 0 && `（其中 ${spineDebt.length} 本已判層為脊梁）`}。
              </p>
              <div class="cover-wall">
                {debt.map((r) =>
                  r.e.slug ? (
                    <a
                      class="cover-wall-item"
                      href={bookUrl(r.e.slug)}
                      target="_blank"
                      rel="noopener"
                      title={`${r.e.title}${r.e.tier === "spine" ? "（脊梁）" : ""}`}
                    >
                      <img
                        class="cover-img"
                        src={bookCoverUrl(r.e.slug)}
                        data-fallback={bookUrl(r.e.slug, "cover.png")}
                        alt={r.e.title}
                        loading="lazy"
                        decoding="async"
                        width="66"
                        height="95"
                      />
                      {r.e.tier === "spine" && (
                        <span class="cover-wall-seal seal" aria-hidden="true" />
                      )}
                    </a>
                  ) : (
                    <span class="cover-wall-item is-plain" title={r.e.title}>
                      <span class="cover-wall-ph">{r.e.title}</span>
                    </span>
                  )
                )}
              </div>
            </div>
          )}

          {excused.length > 0 && (
            <details class="ex">
              <summary class="ex-sum">
                <span class="ex-title">另 {excused.length} 本已判層、刻意不在本站深挖</span>
                <span class="ex-mix">
                  {excusedGroups.map((g) => (
                    <span class="ex-mixdot">
                      <i class={`tier-dot ${g.meta.dot}`} />
                      {g.meta.label} {g.books.length}
                    </span>
                  ))}
                </span>
                <span class="ex-sign" aria-hidden="true" />
              </summary>

              <div class="ex-body">
                {excusedGroups.map((g) => (
                  <section class="ex-grp">
                    <h4>
                      <i class={`tier-dot ${g.meta.dot}`} />
                      {g.meta.label}
                      <span class="ex-n">{g.books.length}</span>
                      <span class="ex-why">{g.meta.reason}</span>
                    </h4>
                    {g.tier === "delegated" && delegatedChips.length > 0 && (
                      <p class="ex-chips">
                        {delegatedChips.map(([key, n]) => (
                          <a class="ex-chip" href={siteUrl(key)} target="_blank" rel="noopener">
                            {siteLabel(key)}
                            <b>{n}</b>
                          </a>
                        ))}
                      </p>
                    )}
                    <div class="ex-shelf">
                      {g.books.map((r) =>
                        r.e.slug ? (
                          <a
                            class="ex-bk"
                            href={bookUrl(r.e.slug)}
                            target="_blank"
                            rel="noopener"
                            title={`${r.e.title}｜${g.meta.label}——${g.meta.reason}`}
                          >
                            <img
                              class="cover-img"
                              src={bookCoverUrl(r.e.slug)}
                              data-fallback={bookUrl(r.e.slug, "cover.png")}
                              alt=""
                              loading="lazy"
                              decoding="async"
                              width="66"
                              height="95"
                            />
                            <span class="ex-cap">{r.e.title}</span>
                          </a>
                        ) : (
                          <span class="ex-bk is-plain" title={`${r.e.title}｜${g.meta.label}`}>
                            <span class="ex-ph" />
                            <span class="ex-cap">{r.e.title}</span>
                          </span>
                        )
                      )}
                    </div>
                  </section>
                ))}

                {showClusters && (
                  <section class="ex-grp">
                    <h4>
                      Authors
                      <span class="ex-why">同一位作者 ≥2 本才列</span>
                    </h4>
                    <ul class="ex-cl">
                      {authorClusters.map((c) => (
                        <li>
                          <span class="ex-who">{c.author}</span>
                          <span class="ex-cn">{c.books.length}</span>
                          <span class="ex-comp">
                            {c.books.map((r) => (
                              <i
                                class={`tier-dot sm ${TIER_META[r.e.tier!].dot}`}
                                title={TIER_META[r.e.tier!].label}
                              />
                            ))}
                          </span>
                          <span class="ex-cmix">
                            {EXCUSED_TIERS.filter((t) => c.books.some((r) => r.e.tier === t))
                              .map(
                                (t) =>
                                  `${TIER_META[t].label} ${c.books.filter((r) => r.e.tier === t).length}`
                              )
                              .join(" · ")}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </section>
                )}
              </div>
            </details>
          )}
        </div>
      </section>
    )
  }

  <Bibliography entries={entries} num={pad2(showMining ? 2 : 1)} />
</BaseLayout>

<script>
  document.addEventListener(
    "error",
    (e) => {
      const img = e.target;
      if (!(img instanceof HTMLImageElement) || !img.classList.contains("cover-img")) return;
      const fallback = img.dataset.fallback;
      if (!fallback || img.src === fallback) return;
      img.src = fallback;
      delete img.dataset.fallback;
    },
    true
  );
</script>
