---
import VolumeHead from "../../../components/VolumeHead.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProblemCard from "../../../components/ProblemCard.astro";
import TocWrap from "../../../components/TocWrap.astro";
import Crumbs from "../../../components/Crumbs.astro";
import { byImportance } from "../../../lib/collections";
import { pad2, DIFFICULTY_LEVEL, latinLang, splitTitle } from "../../../lib/toc";
import { withBase } from "../../../lib/url";
import { bySlug } from "../../../lib/collections";
import { site } from "virtual:notes-core/site";
import { getDomains } from "../../../lib/nav-data";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const problems = await getCollection("problems");
  const { domains } = await getDomains();
  let n = 0;
  return domains.map((dm: any) => {
    const items = problems.filter((p) => p.data.domain === dm.slug).sort(byImportance);
    return {
      params: { domain: dm.slug },
      props: { domain: dm, items, num: items.length > 0 ? ++n : 0 },
    };
  });
}

const { domain, items, num } = Astro.props;
const problemLabel = site.problemLabelEn ?? "Problems";
const conceptSet = new Set<string>(items.flatMap((p: any) => p.data.concepts ?? []));
const conceptBySlug = bySlug(await getCollection("concepts"));
const uses = new Map<string, number>();
for (const p of items as any[]) {
  for (const c of p.data.concepts ?? []) uses.set(c, (uses.get(c) ?? 0) + 1);
}
const drilled = [...uses.entries()]
  .map(([slug, n]) => ({ entry: conceptBySlug.get(slug), n }))
  .filter((x) => x.entry)
  .sort((a, b) => b.n - a.n || a.entry!.data.title.localeCompare(b.entry!.data.title));
const levels = ["Easy", "Medium", "Hard"]
  .map((l) => ({ l, n: items.filter((p: any) => p.data.difficulty === l).length }))
  .filter((x) => x.n > 0);
---

<BaseLayout title={`${domain.name} · ${problemLabel}`} site={site} description={domain.intro}>
  <Crumbs
    site={site}
    items={[{ label: problemLabel, href: "/problems/" }, { label: domain.name }]}
  />
  <header class="page-head idx-head is-wide chapter-open section">
    <VolumeHead page="Domain" num={num > 0 ? pad2(num) : undefined} class="idx-kicker" />
    <h1 class="idx-title" lang={latinLang(domain.name)}>{domain.name}</h1>
    <dl class="co-stats">
      <div>
        <dt>Problems</dt>
        <dd>{items.length}</dd>
      </div>
      {
        levels.map((x) => (
          <div>
            <dt>
              <span class="diff" data-level={DIFFICULTY_LEVEL[x.l.toLowerCase()]}>
                <span class="diff-bars" aria-hidden="true">
                  <i />
                  <i />
                  <i />
                </span>
                {x.l}
              </span>
            </dt>
            <dd>{x.n}</dd>
          </div>
        ))
      }
      {
        conceptSet.size > 0 && (
          <div>
            <dt>Concepts</dt>
            <dd>{conceptSet.size}</dd>
          </div>
        )
      }
    </dl>
    {domain.intro && <p class="co-intro">{domain.intro}</p>}
  </header>

  <section class="section idx-list is-wide reveal" aria-labelledby="problems-h">
    <h2 class="running-head" id="problems-h">
      <span class="running-head-num">01</span>Problems
    </h2>
    {
      items.length > 0 ? (
        <div class="section-body">
          <p class="rows-key" aria-hidden="true">
            Importance
            <span class="imp">
              <i class="on" />
              <i class="on" />
              <i class="on" />
              <i />
              <i />
            </span>
          </p>
          <ol class="rows">
            {items.map((entry: any, i: number) => (
              <ProblemCard entry={entry} index={i + 1} />
            ))}
          </ol>
        </div>
      ) : (
        <p class="section-body idx-empty">這個領域還沒有寫成的題目。</p>
      )
    }
  </section>

  {
    drilled.length > 0 && (
      <section class="section idx-list is-wide reveal" aria-labelledby="drilled-h">
        <h2 class="running-head" id="drilled-h">
          <span class="running-head-num">02</span>Concepts
        </h2>
        <div class="section-body">
          <ul class="toc-lines">
            {drilled.map(({ entry, n }) => {
              const t = splitTitle(entry!.data.title);
              return (
                <li class="toc-line">
                  <a class="toc-row" href={withBase(`concepts/${entry!.id}/`)}>
                    <span class="toc-t">
                      <span class="toc-main">{t.main}</span>
                      {t.sub && <span class="toc-sub">{t.sub}</span>}
                      {t.en && <span class="toc-en">{t.en}</span>}
                    </span>
                    <span class="toc-dots" aria-hidden="true" />
                    <span class="toc-tier" title={`Used by ${n} of these problems`}>
                      ×{n}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )
  }
  <TocWrap />
</BaseLayout>
