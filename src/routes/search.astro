---
import BaseLayout from "../layouts/BaseLayout.astro";
import Crumbs from "../components/Crumbs.astro";
import { withBase } from "../lib/url";
import { pad2 } from "../lib/toc";
import { site } from "virtual:notes-core/site";
import { getCategories } from "../lib/nav-data";
import { getCollection } from "astro:content";

const pagefindUiCss = withBase("pagefind/pagefind-ui.css");
const pagefindUiJs = withBase("pagefind/pagefind-ui.js");
const bundlePath = withBase("pagefind/");
const placeholder = site.searchPlaceholder ?? "Search notes…";
const conceptLabel = site.conceptLabelEn ?? "Concepts";

const concepts = await getCollection("concepts");
const { categories } = await getCategories();
const counts = new Map<string, number>();
for (const c of concepts) counts.set(c.data.category, (counts.get(c.data.category) ?? 0) + 1);
const browse = categories.filter((c) => (counts.get(c.slug) ?? 0) > 0);
---

<BaseLayout title={`Search · ${site.brand}`} site={site}>
  <Crumbs site={site} items={[{ label: "Search" }]} />
  <header class="page-head idx-head is-wide section">
    <p class="running-head idx-kicker">Full text</p>
    <h1 class="idx-title" lang="en">Search</h1>
  </header>

  <section class="search-wrap bleed" aria-label="Search">
    <div class="search-body">
      <label class="search-label label" for="pf-q" hidden>Query</label>
      <div id="search" class="pf-search"></div>
      <noscript>
        <p class="idx-empty search-quiet">搜尋需要 JavaScript；下面的目錄一樣可以帶你到每一頁。</p>
      </noscript>
      <p id="pf-fallback" class="idx-empty search-quiet" hidden>
        搜尋暫時無法使用；下面的目錄一樣可以帶你到每一頁。
      </p>
      {
        browse.length > 0 && (
          <nav class="search-browse" aria-labelledby="browse-h">
            <h2 class="label search-browse-h" id="browse-h">
              Browse {conceptLabel}
            </h2>
            <ol class="idx-jump">
              {browse.map((c, i) => (
                <li>
                  <a href={withBase(`concepts/${c.slug}/`)}>
                    <span class="idx-jump-num">{pad2(i + 1)}</span>
                    {c.name}
                    <span class="search-browse-n">{counts.get(c.slug)}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <p id="pf-loose" class="visually-hidden" aria-live="polite"></p>
    </div>
  </section>

  <link id="pf-css" href={pagefindUiCss} rel="stylesheet" />
  <script is:inline src={pagefindUiJs}></script>
  <script define:vars={{ bundlePath, placeholder }}>
    window.addEventListener("DOMContentLoaded", async () => {
      const host = document.getElementById("search");
      const reveal = () => host?.setAttribute("data-ready", "");
      if (typeof PagefindUI === "undefined") {
        reveal();
        document.getElementById("pf-fallback")?.removeAttribute("hidden");
        return;
      }
      const CJK = "\\u3400-\\u9fff\\uf900-\\ufaff";
      const PUNCT = "\\u3000-\\u303f\\uff01-\\uff0f\\uff1a-\\uff20\\uff3b-\\uff40\\uff5b-\\uff65";
      const TAG = "(?:</?mark>)*";
      const LABELS = [
        "Core Ideas",
        "Case Study",
        "Takeaways",
        "Intuition",
        "Tradeoffs",
        "When to Use",
        "Structure (?:&|&amp;) Variants",
        "Misuse (?:&|&amp;) Anti-patterns",
        "Approaches",
        "Why It(?:'|&#39;|&#x27;|’)s a Problem",
        "Why It Matters",
        "Discussion Log",
        "Signals",
        "Pitfalls",
        "Common Questions",
        "STAR Example",
        "Scenario",
        "Requirements",
        "Reference Design",
      ].join("|");
      const reLabel = new RegExp(
        `(^|[${CJK}${PUNCT}.!?:]${TAG}\\s)(?:${LABELS})\\s(?=${TAG}[${CJK}${PUNCT}])`,
        "g"
      );
      const reStop = new RegExp(`([${CJK}])(${TAG})\\.\\s+`, "g");
      const reGap = new RegExp(`([${CJK}${PUNCT}])(${TAG})\\s+(${TAG})(?=[${CJK}${PUNCT}])`, "g");
      const rePunctSpace = new RegExp(`([${PUNCT}])(${TAG})\\s+`, "g");
      const reEnd = new RegExp(`[。！？!?…]${TAG}$`);
      const reJoin = new RegExp(`([${CJK}])</mark><mark>(?=[${CJK}])`, "g");
      const strip = (s) =>
        typeof s === "string"
          ? s.replace(/[\p{Extended_Pictographic}\u{1F1E6}-\u{1F1FF}]\uFE0F?\s*/gu, "").trim()
          : s;
      const tidy = (s) => {
        if (typeof s !== "string" || !s) return s;
        let x = strip(s).replace(/\s+/g, " ").trim();
        x = x.replace(reLabel, "$1");
        x = x.replace(reStop, "$1$2。");
        x = x.replace(reGap, "$1$2$3");
        x = x.replace(rePunctSpace, "$1$2");
        x = x.replace(reJoin, "$1");
        x = x.replace(/^[\s,，、。.;；:：]+/, "").trim();
        if (!x) return x;
        return "…" + x + (reEnd.test(x) ? "" : "…");
      };
      const EN_TAIL = /^(.*?[^\s])\s*[（(]([^()（）]*[A-Za-z][^()（）]*)[)）]\s*$/;
      const HAS_CJK = new RegExp(`[${CJK}]`);
      const splitTitle = (title) => {
        const m = title.match(EN_TAIL);
        return m && HAS_CJK.test(m[1]) && !HAS_CJK.test(m[2])
          ? { main: m[1], en: m[2] }
          : { main: title, en: "" };
      };
      const decorate = () => {
        const links = host.querySelectorAll(
          ".pagefind-ui__result-inner > .pagefind-ui__result-title > .pagefind-ui__result-link"
        );
        for (const a of links) {
          let main = a.querySelector(":scope > .pf-t-main");
          if (!main) {
            const text = [...a.childNodes].find((n) => n.nodeType === 3);
            if (!text) continue;
            main = document.createElement("span");
            main.className = "pf-t-main";
            a.insertBefore(main, text);
            main.appendChild(text);
          }
          const node = main.firstChild;
          if (!node || node.nodeType !== 3 || a.dataset.split === node.data) continue;
          const t = splitTitle(node.data);
          let en = a.querySelector(":scope > .pf-t-en");
          if (t.en) {
            node.data = t.main;
            if (!en) {
              en = document.createElement("span");
              en.className = "pf-t-en";
              en.lang = "en";
              a.appendChild(en);
            }
            en.textContent = t.en;
          } else if (en) {
            en.remove();
          }
          a.dataset.split = node.data;
        }
      };
      const PHRASE = new RegExp(`^[${CJK}]{2,}$`);
      const real = new URL(`${bundlePath}pagefind.js`, location.href).href;
      const ranked = [
        `import * as pf from ${JSON.stringify(real)};`,
        `export * from ${JSON.stringify(real)};`,
        `const quoted = /^"([${CJK}]{2,})"$/;`,
        "const word = /^[A-Za-z0-9]{3,}$/;",
        "const marked = /<mark>([^<]*)<\\/mark>/g;",
        "async function guarded(term, opts) {",
        "  const found = await pf.search(term, opts);",
        "  if (!found || !word.test(term) || found.results.length === 0) return found;",
        "  const head = term.slice(0, 3).toLowerCase();",
        "  const top = await found.results[0].data();",
        "  const hits = [...top.excerpt.matchAll(marked)].map((x) => x[1].trim().toLowerCase());",
        "  const stray = hits.length > 0 && !hits.some((h) => h.startsWith(head));",
        "  return stray ? { ...found, results: [] } : found;",
        "}",
        "export async function search(term, opts) {",
        "  const m = typeof term === 'string' ? term.match(quoted) : null;",
        "  if (!m) return guarded(term, opts);",
        "  const [exact, loose] = await Promise.all([pf.search(term, opts), pf.search(m[1], opts)]);",
        "  if (!exact || !loose) return exact ?? loose;",
        "  const fallback = exact.results.length === 0;",
        "  document.dispatchEvent(new CustomEvent('pf-phrase', { detail: { term: m[1], fallback } }));",
        "  if (fallback) return loose;",
        "  const score = new Map(loose.results.map((r) => [r.id, r.score]));",
        "  exact.results.sort((a, b) => (score.get(b.id) ?? 0) - (score.get(a.id) ?? 0));",
        "  return exact;",
        "}",
        "",
      ].join("\n");
      const rankedPath = `data:text/javascript;charset=utf-8,${encodeURIComponent(ranked)}//`;
      const phrased = await import(`${rankedPath}pagefind.js`).then(
        () => true,
        () => false
      );
      const note = document.getElementById("pf-loose");
      let looseTerm = "";
      document.addEventListener("pf-phrase", (e) => {
        looseTerm = e.detail.fallback ? e.detail.term : "";
      });
      const showLoose = (t) => {
        const text = t ? `沒有完整的「${t}」，以下是拆字比對的結果。` : "";
        if (note && note.textContent !== text) note.textContent = text;
        if (t) host.style.setProperty("--pf-loose", JSON.stringify(text));
        else host.style.removeProperty("--pf-loose");
      };
      const wide = matchMedia("(min-width: 901px)").matches;
      new PagefindUI({
        element: "#search",
        bundlePath: phrased ? rankedPath : bundlePath,
        showSubResults: true,
        showImages: false,
        pageSize: 8,
        excerptLength: 26,
        openFilters: wide ? ["Category", "Domain", "Type"] : [],
        processTerm: (term) => {
          const t = term.trim();
          if (!PHRASE.test(t)) looseTerm = "";
          return phrased && PHRASE.test(t) ? `"${t}"` : term;
        },
        processResult: (r) => {
          if (r.meta) r.meta.title = strip(r.meta.title);
          r.excerpt = tidy(r.excerpt);
          for (const s of r.sub_results ?? []) {
            s.title = strip(s.title);
            s.excerpt = tidy(s.excerpt);
          }
          return r;
        },
        translations: {
          placeholder,
          clear_search: "Clear",
          load_more: "More results",
          search_label: "Search notes",
          filters_label: "Filter",
          zero_results: "Nothing found for “[SEARCH_TERM]”",
          many_results: "[COUNT] results for “[SEARCH_TERM]”",
          one_result: "[COUNT] result for “[SEARCH_TERM]”",
          alt_search: "Nothing for “[SEARCH_TERM]” — showing “[DIFFERENT_TERM]”",
          search_suggestion: "Nothing found for “[SEARCH_TERM]”",
          searching: "Searching “[SEARCH_TERM]”…",
        },
      });
      const input = host.querySelector(".pagefind-ui__search-input");
      if (input) {
        input.id = "pf-q";
        input.removeAttribute("aria-label");
        document.querySelector(".search-label")?.removeAttribute("hidden");
      }
      let frame = 0;
      new MutationObserver(() => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          decorate();
          const settled = !host.querySelector(".pagefind-ui__loading");
          if (settled) showLoose(looseTerm && input?.value.trim() === looseTerm ? looseTerm : "");
        });
      }).observe(host, { childList: true, subtree: true, characterData: true });
      const css = document.getElementById("pf-css");
      if (css?.sheet) reveal();
      else {
        css?.addEventListener("load", reveal);
        css?.addEventListener("error", reveal);
        setTimeout(reveal, 2500);
      }
    });
  </script>
</BaseLayout>
