---
import SourceByline from "./SourceByline.astro";
import Stars from "./Stars.astro";
import DifficultyPill from "./DifficultyPill.astro";
import Contents from "./Contents.astro";
import { stripEmoji } from "../lib/site-config";
import { splitTitle } from "../lib/reading";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  furtherReading: { book: string; label: string; anchor?: string }[];
  importance: number;
  status: "draft" | "studied" | "reviewed";
  headings: Heading[];
  difficulty?: "Easy" | "Medium" | "Hard";
}
const { furtherReading, importance, status, headings, difficulty } = Astro.props;
const toc = headings
  .filter((h) => h.depth === 2 && h.slug !== "footnote-label")
  .map((h) => ({ slug: h.slug, text: splitTitle(stripEmoji(h.text)).main }));
const statusLabel = status === "draft" ? "" : status === "studied" ? "Studied" : "Reviewed";
---

<aside class="marginalia" aria-label="About this page">
  <div class="mg-inner">
    <SourceByline items={furtherReading} />
    <div class="mg-block mg-rating">
      {
        difficulty && (
          <div class="mg-difficulty">
            <p class="mg-label">Difficulty</p>
            <DifficultyPill difficulty={difficulty} />
          </div>
        )
      }
      <div class="mg-importance">
        <p class="mg-label">Importance</p>
        <Stars value={importance} />
      </div>
      {
        statusLabel && (
          <div class="mg-status">
            <p class="mg-label">Status</p>
            <p class="mg-value">{statusLabel}</p>
          </div>
        )
      }
    </div>
    <Contents items={toc} />
  </div>
</aside>

