---
import { currentVolume } from "../lib/volume";
import { stripEmoji } from "../lib/site-config";
import { site } from "virtual:notes-core/site";
import { withBase } from "../lib/url";

interface Props {
  section: string;
  sectionHref?: string;
  num?: string;
  emblem?: boolean;
  index?: boolean;
  class?: string;
}
const { section, sectionHref, num, emblem = false, index = false, class: cls } = Astro.props;
const vol = currentVolume(site.titleBase ?? site.brand);
const label = stripEmoji(section);
---

<p class:list={["volume-head", { "is-index running-head": index }, cls]}>
  <span class="volume-swatch" aria-hidden="true"></span>
  {vol.serial && <span class="volume-serial">{vol.serial}</span>}
  <a class="volume-label" href={withBase("/")}>{vol.label}</a>
  <span class="volume-sep" aria-hidden="true">{index ? "/" : "·"}</span>
  {
    sectionHref ? (
      <a class="volume-section" href={withBase(sectionHref)}>
        {label}
        {num && <span class="volume-num">{num}</span>}
      </a>
    ) : (
      <span class="volume-section">
        {label}
        {num && <span class="volume-num">{num}</span>}
      </span>
    )
  }
  {emblem && vol.emblem && <span class="volume-mark" aria-hidden="true" set:html={vol.emblem} />}
</p>
{index && vol.style && <style is:inline set:html={`:root{${vol.style}}`} />}
