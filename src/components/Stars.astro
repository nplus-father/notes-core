---
interface Props {
  value: number;
}
const { value } = Astro.props;
const full = Math.max(0, Math.min(5, Math.round(value)));
---

<span class="stars" role="img" aria-label={`Importance ${full} of 5`} title={`Importance ${full}/5`}>
  {Array.from({ length: 5 }, (_, i) => <span class:list={["stars-cell", { "is-on": i < full }]} />)}
</span>
