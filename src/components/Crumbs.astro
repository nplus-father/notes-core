---
import { withBase } from "../lib/url";
import { stripEmoji, type SiteConfig } from "../lib/site-config";

interface Crumb {
  label: string;
  /** base-relative 路徑（如 "/concepts/"）；省略 = 當前頁，不可點 */
  href?: string;
  icon?: string;
}
interface Props {
  site: SiteConfig;
  /** 站首頁之後的祖先鏈，由外而內；最後一項通常不給 href */
  items?: Crumb[];
}
const { site, items = [] } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    <li><a class="crumb-home" href={withBase("/")}>{site.brand}</a></li>
    {
      items.map((c) => (
        <li>
          {c.href ? (
            <a href={withBase(c.href)}>{stripEmoji(c.label)}</a>
          ) : (
            <span aria-current="page">{stripEmoji(c.label)}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
