---
interface Props {
  difficulty: "Easy" | "Medium" | "Hard";
}
const { difficulty } = Astro.props;
const level = { Easy: 1, Medium: 2, Hard: 3 }[difficulty] ?? 0;
---

<span class={`pill diff-${difficulty.toLowerCase()}`} title={`Difficulty: ${difficulty}`}>
  <span class="diff-steps" aria-hidden="true">
    {[1, 2, 3].map((n) => <span class:list={["diff-step", { "is-on": n <= level }]} />)}
  </span>
  <span class="diff-text">{difficulty}</span>
</span>
