---
import Icon from "./Icon.astro";
import { splitTitle } from "../lib/reading";
interface Item {
  href: string;
  title: string;
}
interface Props {
  prev: Item | null;
  next: Item | null;
  ariaLabel: string;
  prevLabel: string;
  nextLabel: string;
}
const { prev, next, ariaLabel, prevLabel, nextLabel } = Astro.props;
const p = prev ? splitTitle(prev.title) : null;
const n = next ? splitTitle(next.title) : null;
const showLatin = [p, n].every((t) => t === null || t.latin !== null);
---

{
  (prev || next) && (
    <nav class="prevnext" aria-label={ariaLabel}>
      {prev ? (
        <a class="pn pn-prev" href={prev.href}>
          <span class="pn-dir">
            <Icon name="arrow-left" size={16} />
            {prevLabel}
          </span>
          <span class="pn-title">
            <span class="pn-title-text">{p?.main}</span>
            {showLatin && p?.latin && (
              <span class="pn-latin" lang="en">
                {p.latin}
              </span>
            )}
          </span>
        </a>
      ) : (
        <span class="pn pn-empty" />
      )}
      {next ? (
        <a class="pn pn-next" href={next.href}>
          <span class="pn-dir">
            {nextLabel}
            <Icon name="arrow-right" size={16} />
          </span>
          <span class="pn-title">
            <span class="pn-title-text">{n?.main}</span>
            {showLatin && n?.latin && (
              <span class="pn-latin" lang="en">
                {n.latin}
              </span>
            )}
          </span>
        </a>
      ) : (
        <span class="pn pn-empty" />
      )}
    </nav>
  )
}
