---
import Icon from "./Icon.astro";
import { splitTitle } from "../lib/reading";
interface Item {
  href: string;
  title: string;
}
interface Props {
  prev: Item | null;
  next: Item | null;
  ariaLabel: string;
  prevLabel: string;
  nextLabel: string;
}
const { prev, next, ariaLabel, prevLabel, nextLabel } = Astro.props;
---

{
  (prev || next) && (
    <nav class="prevnext" aria-label={ariaLabel}>
      {prev ? (
        <a class="pn pn-prev" href={prev.href}>
          <span class="pn-dir">
            <Icon name="arrow-left" size={16} />
            {prevLabel}
          </span>
          <span class="pn-title">
            <span class="pn-title-text">{splitTitle(prev.title).main}</span>
            {splitTitle(prev.title).latin && (
              <span class="pn-latin" lang="en">
                {splitTitle(prev.title).latin}
              </span>
            )}
          </span>
        </a>
      ) : (
        <span class="pn pn-empty" />
      )}
      {next ? (
        <a class="pn pn-next" href={next.href}>
          <span class="pn-dir">
            {nextLabel}
            <Icon name="arrow-right" size={16} />
          </span>
          <span class="pn-title">
            <span class="pn-title-text">{splitTitle(next.title).main}</span>
            {splitTitle(next.title).latin && (
              <span class="pn-latin" lang="en">
                {splitTitle(next.title).latin}
              </span>
            )}
          </span>
        </a>
      ) : (
        <span class="pn pn-empty" />
      )}
    </nav>
  )
}
