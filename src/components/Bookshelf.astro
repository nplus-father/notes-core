---
// 首頁「參考書架」：一眼看出本站彙整自哪些 owned books（書的歸屬放首頁，
// 各主題頁內文就不必逐段標書名）。books 由各站 src/data/books.ts 提供。
//
// 縮圖走 bookCoverUrl() 的代理（見 links.ts）而非書 repo 的原始 PNG：
// 顯示只有 132×190，原圖卻平均 280KB，書多的站一頁能吃掉 21MB。
import { bookUrl, bookCoverUrl } from "../lib/links";
interface Book {
  slug: string;
  title: string;
}
interface Props {
  books: Book[];
  heading?: string;
  note?: string;
  /** 選用：「完整盤點」入口（/library/）。首頁書架只擺 owned 封面，狀態與缺口在那邊。 */
  moreHref?: string;
}
const {
  books,
  heading = "Sources",
  note = "The books this site distills from — every page traces back",
  moreHref,
} = Astro.props;
---

{
  books.length > 0 && (
    <section class="bookshelf">
      <div class="bookshelf-head">
        <h2>{heading}</h2>
        <span class="bookshelf-note">{note}</span>
        <span class="bookshelf-count">{books.length}</span>
        {
          moreHref && (
            <a class="bookshelf-more" href={moreHref}>
              盤點與開採度 →
            </a>
          )
        }
      </div>
      {/* 固定高度的捲動窗（v0.29.0）：書多的站（tracy 35 本、startup 61 本）攤開會是
          好幾排 190px 高的封面，把下面的盤點表整個推出首屏。高度收在 CSS
          （--shelf-h，約兩排半），封面列本身不變。 */}
      <div class="bookshelf-scroll">
        <div class="cover-row">
          {books.map((b) => (
            <a
              class="cover-item"
              href={bookUrl(b.slug)}
              target="_blank"
              rel="noopener"
              title={b.title}
            >
              <img
                class="cover-img"
                src={bookCoverUrl(b.slug)}
                data-fallback={bookUrl(b.slug, "cover.png")}
                alt={b.title}
                loading="lazy"
                decoding="async"
                width="132"
                height="190"
              />
              <span class="cover-cap">{b.title}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

<script>
  // 代理退路：wsrv.nl 掛掉／被擋時退回書 repo 的原圖（慢，但不破圖）。
  // 用 capture 監聽——img 的 error 不冒泡，委派只能在捕獲階段接到。
  // 一頁只掛一個監聽器，不隨書數增加。
  document.addEventListener(
    "error",
    (e) => {
      const img = e.target;
      if (!(img instanceof HTMLImageElement) || !img.classList.contains("cover-img")) return;
      const fallback = img.dataset.fallback;
      if (!fallback || img.src === fallback) return;
      img.src = fallback;
      delete img.dataset.fallback; // 只退一次，原圖再壞就讓它壞，別無限重試
    },
    true,
  );
</script>
