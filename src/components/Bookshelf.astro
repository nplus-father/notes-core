---
import { bookUrl, bookCoverUrl } from "../lib/links";
import Icon from "./Icon.astro";
interface Book {
  slug: string;
  title: string;
}
interface Props {
  books: Book[];
  heading?: string;
  moreHref?: string;
  num?: string;
}
const { books, heading = "Sources", moreHref, num = "" } = Astro.props;
---

{
  books.length > 0 && (
    <section class="section shelf" aria-labelledby="shelf-title">
      <div class="running-head home-head">
        <h2 class="home-head-title" id="shelf-title">
          {num && <span class="running-head-num">{num}</span>}
          <span lang="en">{heading}</span>
        </h2>
        <p class="home-head-meta">
          <span>{String(books.length).padStart(2, "0")}</span>
          <span lang="en">{books.length === 1 ? "Book" : "Books"}</span>
        </p>
        {moreHref && (
          <a class="home-rail-more shelf-more" href={moreHref}>
            <span lang="en">Library</span>
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        )}
      </div>
      <div class="section-body shelf-body">
        <div class="shelf-bar" data-shelf-bar>
          <p class="shelf-pos" aria-live="polite">
            <span class="shelf-pos-range">1–{books.length}</span>
            <span class="shelf-pos-sep">/</span>
            <span>{books.length}</span>
          </p>
          <div class="shelf-nav">
            <button type="button" class="shelf-btn" data-dir="-1" aria-label="Previous books">
              <Icon name="arrow-left" size={20} />
            </button>
            <button type="button" class="shelf-btn" data-dir="1" aria-label="Next books">
              <Icon name="arrow-right" size={20} />
            </button>
          </div>
        </div>
        <div
          class="shelf-scroller"
          tabindex="0"
          role="region"
          aria-label="Sources shelf"
          data-shelf
        >
          <ul class="shelf-row">
            {books.map((b) => (
              <li class="shelf-book">
                <a class="shelf-link" href={bookUrl(b.slug)} target="_blank" rel="noopener">
                  <img
                    class="cover-img shelf-cover"
                    src={bookCoverUrl(b.slug)}
                    data-fallback={bookUrl(b.slug, "cover.png")}
                    alt={b.title}
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                    width="132"
                    height="190"
                  />
                  <span class="shelf-title" aria-hidden="true">
                    {b.title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )
}

<script>
  for (const el of document.querySelectorAll<HTMLElement>("[data-shelf]")) {
    const bar = el.parentElement?.querySelector<HTMLElement>("[data-shelf-bar]");
    const range = bar?.querySelector<HTMLElement>(".shelf-pos-range");
    const [prev, next] = [...(bar?.querySelectorAll<HTMLButtonElement>(".shelf-btn") ?? [])];
    const books = [...el.querySelectorAll<HTMLElement>(".shelf-book")];
    const update = () => {
      const max = el.scrollWidth - el.clientWidth;
      const atStart = el.scrollLeft <= 2;
      const atEnd = el.scrollLeft >= max - 2;
      el.classList.toggle("at-start", atStart);
      el.classList.toggle("at-end", atEnd);
      el.classList.toggle("is-static", max <= 2);
      if (!bar) return;
      bar.classList.toggle("is-ready", max > 2);
      const box = el.getBoundingClientRect();
      const right = box.right - parseFloat(getComputedStyle(el).paddingRight);
      const seen = books
        .map((b, i) => ({ r: b.getBoundingClientRect(), i }))
        .filter(({ r }) => r.left >= box.left - 2 && r.right <= right + 2)
        .map(({ i }) => i + 1);
      if (range && seen.length) range.textContent = `${seen[0]}–${seen.at(-1)}`;
      if (prev) prev.disabled = atStart;
      if (next) next.disabled = atEnd;
    };
    const page = (dir: number) => {
      const step = Math.max(el.clientWidth - parseFloat(getComputedStyle(el).paddingRight) - 40, 120);
      el.scrollBy({ left: dir * step, behavior: "smooth" });
    };
    prev?.addEventListener("click", () => page(-1));
    next?.addEventListener("click", () => page(1));
    update();
    el.addEventListener("scroll", update, { passive: true });
    addEventListener("resize", update, { passive: true });

    let startX = 0;
    let startLeft = 0;
    let dragging = false;
    let moved = false;
    el.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse" || e.button !== 0) return;
      dragging = true;
      moved = false;
      startX = e.clientX;
      startLeft = el.scrollLeft;
    });
    el.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (!moved && Math.abs(dx) > 4) {
        moved = true;
        el.setPointerCapture(e.pointerId);
        el.classList.add("is-dragging");
      }
      if (moved) el.scrollLeft = startLeft - dx;
    });
    const end = () => {
      dragging = false;
      el.classList.remove("is-dragging");
    };
    el.addEventListener("dragstart", (e) => e.preventDefault());
    el.addEventListener("pointerup", end);
    el.addEventListener("pointercancel", end);
    el.addEventListener(
      "click",
      (e) => {
        if (moved) {
          e.preventDefault();
          e.stopPropagation();
          moved = false;
        }
      },
      true,
    );
    el.addEventListener("keydown", (e) => {
      if (e.target !== el) return;
      const step = el.clientWidth * 0.8;
      if (e.key === "PageDown") el.scrollBy({ left: step });
      else if (e.key === "PageUp") el.scrollBy({ left: -step });
      else if (e.key === "Home") el.scrollTo({ left: 0 });
      else if (e.key === "End") el.scrollTo({ left: el.scrollWidth });
      else return;
      e.preventDefault();
    });
  }
</script>
