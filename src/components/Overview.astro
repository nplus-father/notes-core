---
// 首頁「總覽」（v0.29.0；v0.31.0 分段收進 tab）：讓人一次讀懂這個領域／這個人的樣貌。
// 資料由各站 src/data/overview.ts 提供（型別見 lib/library.ts），由 /note-guide 產出。
//
// 版面（v0.31.0）：lede 一句話**常駐**——它是把全站壓成一句的那行，是這一格的存在理由，
// 不進 tab；三段（背景／貢獻／主要論點…）收進切換鍵，減少首頁置放長度。
// 機制沿 Bibliography 分組鍵的同一套語彙：鍵預設 hidden、由 script 打開，無 JS 退回全段攤開；
// 非當前段 hidden="until-found"（伺服端就標好，不閃版），Ctrl+F 搜得到、搜到自動切段，
// 無 JS 由 <noscript> 樣式攤開。
import type { SiteOverview, OverviewKind } from "../lib/library";

interface Props {
  overview?: SiteOverview | null;
}
const { overview } = Astro.props;

const KINDS: Record<OverviewKind, string> = {
  domain: "領域總覽",
  person: "人物總覽",
};
const heading = overview ? (KINDS[overview.kind] ?? KINDS.domain) : KINDS.domain;
---

{
  overview && overview.sections.length > 0 && (
    <section class="overview">
      <div class="overview-head">
        <h2>{heading}</h2>
        {/* 判讀會過期（書單再進新書、概念頁再翻修），所以把「依哪一版站況寫的」印出來，
            與頁尾的 curation 徽章同一個理由。沒填就不出，不要假裝新鮮。 */}
        {overview.writtenAt && (
          <span class="overview-stamp" title="這份總覽依當時的站況寫成">
            {overview.writtenAt}
          </span>
        )}
      </div>

      <div class="overview-body">
        <p class="overview-lede" set:html={overview.lede} />

        <div class="overview-tabs" role="group" aria-label="總覽段落" hidden>
          {overview.sections.map((s, i) => (
            <button
              type="button"
              class={`overview-tab${i === 0 ? " is-active" : ""}`}
              aria-pressed={i === 0 ? "true" : "false"}
              data-sec={String(i)}
            >
              {s.heading}
            </button>
          ))}
        </div>

        {overview.sections.map((s, i) => (
          <div
            class="overview-section"
            data-sec={String(i)}
            hidden={i === 0 ? undefined : "until-found"}
          >
            <h3 class="overview-section-name">{s.heading}</h3>
            <p class="overview-text" set:html={s.body} />
          </div>
        ))}
      </div>

      {/* 無 JS：切換鍵不出（死鍵不如不擺），三段攤開。hidden="until-found" 在支援的瀏覽器
          是 content-visibility、其餘退化成 display:none——兩者都在這裡蓋回可見。 */}
      <noscript>
        <style>
          .overview-section[hidden] {
            display: block;
            content-visibility: visible;
          }
        </style>
      </noscript>
    </section>
  )
}

<script>
  // 段落切換：同一份 DOM 開關 hidden，不重畫。找頁（Ctrl+F）命中隱藏段時瀏覽器發
  // beforematch——把該段轉為當前 tab，別讓命中內容亮一下又被收回去。
  for (const root of document.querySelectorAll<HTMLElement>(".overview")) {
    const tabs = root.querySelector<HTMLElement>(".overview-tabs");
    const buttons = [...root.querySelectorAll<HTMLButtonElement>(".overview-tab")];
    const sections = [...root.querySelectorAll<HTMLElement>(".overview-section")];
    if (!tabs || buttons.length === 0) continue;

    tabs.hidden = false;
    root.classList.add("is-tabbed"); // tab 化後段內 h3 與鍵重複，由 CSS 收掉

    const activate = (sec: string) => {
      for (const b of buttons) {
        const on = b.dataset.sec === sec;
        b.classList.toggle("is-active", on);
        b.setAttribute("aria-pressed", String(on));
      }
      for (const s of sections) {
        if (s.dataset.sec === sec) s.removeAttribute("hidden");
        else s.setAttribute("hidden", "until-found");
      }
    };

    for (const b of buttons) b.addEventListener("click", () => activate(b.dataset.sec ?? "0"));
    for (const s of sections)
      s.addEventListener("beforematch", () => activate(s.dataset.sec ?? "0"));
  }
</script>
