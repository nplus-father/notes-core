---
import type { SiteOverview } from "../lib/library";

interface Props {
  overview?: SiteOverview | null;
  num?: string;
}
const { overview, num = "" } = Astro.props;
const uid = "ov";
---

{
  overview && overview.sections.length > 0 && (
    <section class="section overview" aria-labelledby={`${uid}-title`}>
      <div class="running-head home-head">
        <h2 class="home-head-title" id={`${uid}-title`}>
          {num && <span class="running-head-num">{num}</span>}
          <span lang="en">Overview</span>
        </h2>
        {overview.writtenAt && (
          <p class="home-head-meta">
            <span lang="en">Written</span>
            <time datetime={overview.writtenAt}>{overview.writtenAt}</time>
          </p>
        )}
        {overview.sections.length > 1 && (
          <ol class="home-rail-index overview-index">
            {overview.sections.map((s, i) => (
              <li>
                <a
                  href={`#${uid}-panel-${i}`}
                  data-sec={String(i)}
                  aria-current={i === 0 ? "true" : undefined}
                >
                  <span class="home-rail-num">{String(i + 1).padStart(2, "0")}</span>
                  <span>{s.heading}</span>
                </a>
              </li>
            ))}
          </ol>
        )}
      </div>

      <div class="section-body overview-body">
        <p class="overview-lede reveal" set:html={overview.lede} />

        <div
          class="overview-tabs text-tabs"
          role="tablist"
          aria-label="Overview sections"
          data-edge-fade
          hidden
        >
          {overview.sections.map((s, i) => (
            <button
              type="button"
              role="tab"
              class="text-tab overview-tab"
              id={`${uid}-tab-${i}`}
              aria-controls={`${uid}-panel-${i}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? "0" : "-1"}
              data-sec={String(i)}
            >
              <span class="overview-tab-num" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span>{s.heading}</span>
            </button>
          ))}
        </div>

        <div class="overview-panels">
          {overview.sections.map((s, i) => (
            <div
              class="overview-section"
              id={`${uid}-panel-${i}`}
              data-sec={String(i)}
              hidden={i === 0 ? undefined : "until-found"}
            >
              <h3 class="overview-section-name">
                <span class="overview-section-num" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                {s.heading}
              </h3>
              <p class="overview-text" set:html={s.body} />
            </div>
          ))}
        </div>
      </div>

      <noscript>
        <style>
          .overview-section[hidden] {
            display: block;
            content-visibility: visible;
          }
        </style>
      </noscript>
    </section>
  )
}

<script>
  for (const root of document.querySelectorAll<HTMLElement>(".overview")) {
    const list = root.querySelector<HTMLElement>(".overview-tabs");
    const tabs = [...root.querySelectorAll<HTMLButtonElement>(".overview-tab")];
    const index = [...root.querySelectorAll<HTMLAnchorElement>(".overview-index a")];
    const panels = [...root.querySelectorAll<HTMLElement>(".overview-section")];
    if (!list || tabs.length === 0) continue;

    list.hidden = false;
    list.dispatchEvent(new Event("scroll"));
    root.classList.add("is-tabbed");
    panels.forEach((p, i) => {
      p.setAttribute("role", "tabpanel");
      p.setAttribute("aria-labelledby", tabs[i]?.id ?? "");
      p.tabIndex = 0;
    });

    const activate = (sec: string, focus = false) => {
      for (const t of tabs) {
        const on = t.dataset.sec === sec;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      }
      for (const p of panels) {
        if (p.dataset.sec === sec) p.removeAttribute("hidden");
        else p.setAttribute("hidden", "until-found");
      }
      for (const a of index) {
        if (a.dataset.sec === sec) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      }
    };

    for (const a of index) {
      a.addEventListener("click", (e) => {
        e.preventDefault();
        activate(a.dataset.sec ?? "0");
      });
    }

    tabs.forEach((t, i) => {
      t.addEventListener("click", () => activate(t.dataset.sec ?? "0"));
      t.addEventListener("keydown", (e) => {
        const last = tabs.length - 1;
        const to =
          e.key === "ArrowRight" || e.key === "ArrowDown"
            ? i === last ? 0 : i + 1
            : e.key === "ArrowLeft" || e.key === "ArrowUp"
              ? i === 0 ? last : i - 1
              : e.key === "Home"
                ? 0
                : e.key === "End"
                  ? last
                  : -1;
        if (to < 0) return;
        e.preventDefault();
        activate(tabs[to].dataset.sec ?? "0", true);
      });
    });
    for (const p of panels) p.addEventListener("beforematch", () => activate(p.dataset.sec ?? "0"));
  }
</script>
