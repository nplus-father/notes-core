---
import Icon from "./Icon.astro";
import CoverFallback from "./CoverFallback.astro";
import { bookUrl, bookCoverUrl, splitBookLabel } from "../lib/links";
interface Item {
  book: string;
  label: string;
  anchor?: string;
}
interface Props {
  items: Item[];
  level?: 2 | 3;
  heading?: string;
}
const { items, level = 2, heading = "Further Reading" } = Astro.props;
const H = `h${level}`;
---

{
  items.length > 0 && (
    <section class="endnote further">
      <H class="endnote-head">{heading}</H>
      <ul class="rl">
        {items.map((it) => {
          const p = splitBookLabel(it.label);
          return (
            <li>
              <a class="rl-row" href={bookUrl(it.book, it.anchor)} target="_blank" rel="noopener">
                <img
                  class="rl-cover"
                  src={bookCoverUrl(it.book, 120)}
                  data-fallback={bookUrl(it.book, "cover.png")}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  width="40"
                  height="54"
                />
                <span class="rl-text">
                  <span class="rl-title">{p.chapter}</span>
                  {p.book && <span class="rl-meta">{p.book}</span>}
                </span>
                <Icon name="arrow-up-right" size={18} class="rl-arrow" />
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )
}
<CoverFallback />
