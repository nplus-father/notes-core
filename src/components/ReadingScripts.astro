---
import { icons } from "../lib/icons";
const copyIcon = icons.copy;
const doneIcon = icons.check;
---

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".mg-toc a[data-toc]")];
  if (links.length > 0) {
    const resolve = (a: HTMLAnchorElement) => {
      const id = a.dataset.toc ?? "";
      const scope = a.closest(".guide-chapter");
      const el =
        scope?.querySelector<HTMLElement>(`[id="${CSS.escape(id)}"]`) ??
        document.getElementById(id);
      return el ? (el.closest<HTMLElement>(".section-head") ?? el) : null;
    };
    const pairs = links.map((a) => ({ a, el: resolve(a) }));
    let queued = false;
    const update = () => {
      queued = false;
      const live = pairs.filter(
        (p): p is { a: HTMLAnchorElement; el: HTMLElement } =>
          p.el !== null && p.el.checkVisibility()
      );
      if (live.length === 0) return;
      const doc = document.documentElement;
      const left = Math.max(0, doc.scrollHeight - innerHeight - scrollY);
      const line = innerHeight * 0.35 + Math.max(0, innerHeight * 0.65 - left);
      let current = live[0].el;
      for (const p of live) if (p.el.getBoundingClientRect().top <= line) current = p.el;
      for (const p of pairs) {
        if (p.el === current) p.a.setAttribute("aria-current", "location");
        else p.a.removeAttribute("aria-current");
      }
    };
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    addEventListener("scroll", queue, { passive: true });
    addEventListener("resize", queue);
    addEventListener("hashchange", queue);
    document.addEventListener("click", queue);
    update();
  }

  for (const fig of document.querySelectorAll<HTMLElement>(".code-block, .diagram")) {
    const pre = fig.querySelector<HTMLElement>("pre, .diagram-scroll");
    if (!pre) continue;
    const measure = () => {
      const max = pre.scrollWidth - pre.clientWidth;
      const at = pre.scrollLeft;
      fig.dataset.overflow = String(max > 2);
      if (at > 4) fig.classList.add("is-scrolled");
      pre.dataset.cut = [max > 2 && at > 2 && "start", max > 2 && at < max - 2 && "end"]
        .filter(Boolean)
        .join(" ");
    };
    pre.addEventListener("scroll", measure, { passive: true });
    new ResizeObserver(measure).observe(pre);
    measure();
  }
</script>

<script is:inline define:vars={{ copyIcon, doneIcon }}>
  (() => {
    if (!navigator.clipboard) return;
    const svg = (body) =>
      `<svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${body}</svg>`;
    for (const fig of document.querySelectorAll(".code-block")) {
      const head = fig.querySelector(".code-head");
      const code = fig.querySelector("pre code");
      if (!head || !code) continue;
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "code-copy";
      btn.innerHTML = `${svg(copyIcon)}<span>Copy</span>`;
      btn.setAttribute("aria-label", "Copy code");
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(code.innerText.replace(/\n$/, ""));
          btn.innerHTML = `${svg(doneIcon)}<span>Copied</span>`;
          btn.classList.add("is-done");
        } catch {
          btn.innerHTML = `${svg(copyIcon)}<span>Press Ctrl+C</span>`;
        }
        clearTimeout(btn._t);
        btn._t = setTimeout(() => {
          btn.innerHTML = `${svg(copyIcon)}<span>Copy</span>`;
          btn.classList.remove("is-done");
        }, 1800);
      });
      head.append(btn);
    }
  })();
</script>
