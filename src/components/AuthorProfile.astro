---
// 首頁「思想側寫」：人物站的主軸——一句話中心思想、特定貢獻（連站內概念頁）、
// 建議閱讀路徑（直式 stepper：N° 節點＋書封＋一行 why）、思想脈絡（有姊妹站就跨站連結）。
// 資料由各站 src/data/profile.ts 提供（型別見 lib/library.ts）。
import { withBase } from "../lib/url";
import { bookUrl, bookCoverUrl, siteUrl } from "../lib/links";
import type { AuthorProfile, BibliographyEntry } from "../lib/library";

interface Props {
  profile: AuthorProfile;
  bibliography?: BibliographyEntry[];
}
const { profile, bibliography = [] } = Astro.props;
const titleBySlug = new Map(bibliography.filter((e) => e.slug).map((e) => [e.slug, e.title]));
---

<section class="profile">
  <blockquote class="profile-thesis">
    <span class="profile-thesis-label">Thesis</span>
    <p set:html={profile.thesis} />
  </blockquote>

  <h2>Contributions</h2>
  <div class="contrib-grid">
    {
      profile.contributions.map((c) => (
        <article class="contrib-card">
          <div class="contrib-title">
            {c.conceptPath ? (
              <a href={withBase(`/concepts/${c.conceptPath}/`)}>{c.title}</a>
            ) : (
              c.title
            )}
          </div>
          <p class="contrib-summary" set:html={c.summary} />
        </article>
      ))
    }
  </div>

  {
    profile.readingPath && profile.readingPath.length > 0 && (
      <>
        <h2>Reading Path</h2>
        {/* 直式 stepper：節點編號沿用學派卡的 N° 裝置；書封與書架同一個代理
            （.cover-img 掛的是 Bookshelf 的退路監聽——首頁書架必在，共用即可）。 */}
        <ol class="reading-path">
          {profile.readingPath.map((r, i) => (
            <li class="reading-stage">
              <span class="reading-dot">{String(i + 1).padStart(2, "0")}</span>
              <span class="reading-stage-name">{r.stage}</span>
              <span class="reading-why">{r.why}</span>
              <span class="reading-books">
                {r.slugs.map((slug) => (
                  <a
                    class="reading-cover"
                    href={bookUrl(slug)}
                    target="_blank"
                    rel="noopener"
                    title={titleBySlug.get(slug) ?? slug}
                  >
                    <img
                      class="cover-img"
                      src={bookCoverUrl(slug)}
                      data-fallback={bookUrl(slug, "cover.png")}
                      alt={titleBySlug.get(slug) ?? slug}
                      loading="lazy"
                      decoding="async"
                      width="84"
                      height="121"
                    />
                  </a>
                ))}
              </span>
            </li>
          ))}
        </ol>
      </>
    )
  }

  {
    profile.influences && profile.influences.length > 0 && (
      <>
        <h2>Influences</h2>
        <ul class="influences">
          {profile.influences.map((i) => (
            <li>
              {i.site ? (
                <a
                  class="influence-name"
                  href={siteUrl(i.site, "/")}
                  target="_blank"
                  rel="noopener"
                >
                  {i.name}
                </a>
              ) : (
                <span class="influence-name">{i.name}</span>
              )}
              <span class="influence-note">{i.note}</span>
            </li>
          ))}
        </ul>
      </>
    )
  }
</section>
