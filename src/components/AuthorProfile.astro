---
import { withBase } from "../lib/url";
import { bookUrl, bookCoverUrl, siteUrl } from "../lib/links";
import type { AuthorProfile, BibliographyEntry } from "../lib/library";

interface Nums {
  thesis?: string;
  contributions?: string;
  readingPath?: string;
  influences?: string;
}
interface Props {
  profile: AuthorProfile;
  bibliography?: BibliographyEntry[];
  nums?: Nums;
}
const { profile, bibliography = [], nums = {} } = Astro.props;
const titleBySlug = new Map(bibliography.filter((e) => e.slug).map((e) => [e.slug, e.title]));
const pad = (i: number) => String(i + 1).padStart(2, "0");
const contributions = profile.contributions ?? [];
const readingPath = profile.readingPath ?? [];
const influences = profile.influences ?? [];
---

<section class="section is-wide profile-thesis" aria-labelledby="thesis-title">
  <div class="running-head home-head">
    <h2 class="home-head-title" id="thesis-title">
      {nums.thesis && <span class="running-head-num">{nums.thesis}</span>}
      <span lang="en">Thesis</span>
    </h2>
  </div>
  <div class="section-body">
    <blockquote class="thesis reveal">
      <span class="thesis-mark" aria-hidden="true">“</span>
      <p set:html={profile.thesis} />
    </blockquote>
  </div>
</section>

{
  contributions.length > 0 && (
    <section class="section profile-contrib" aria-labelledby="contrib-title">
      <div class="running-head home-head">
        <h2 class="home-head-title" id="contrib-title">
          {nums.contributions && <span class="running-head-num">{nums.contributions}</span>}
          <span lang="en">Contributions</span>
        </h2>
        <p class="home-head-meta">
          <span>{String(contributions.length).padStart(2, "0")}</span>
          <span lang="en">{contributions.length === 1 ? "Entry" : "Entries"}</span>
        </p>
        <ol class="home-rail-index">
          {contributions.map((c, i) => (
            <li>
              <a href={`#contrib-${i + 1}`}>
                <span class="home-rail-num">{pad(i)}</span>
                <span>{c.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
      <div class="section-body">
        <ol class="contrib-grid">
          {contributions.map((c, i) => (
            <li class="contrib reveal" id={`contrib-${i + 1}`}>
              <span class="contrib-num" aria-hidden="true">
                {pad(i)}
              </span>
              <h3 class="contrib-title">
                {c.conceptPath ? (
                  <a class="contrib-link" href={withBase(`/concepts/${c.conceptPath}/`)}>
                    <span class="contrib-link-text">{c.title}</span>
                    <span class="arrow" aria-hidden="true">
                      →
                    </span>
                  </a>
                ) : (
                  c.title
                )}
              </h3>
              <p class="contrib-summary" set:html={c.summary} />
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

{
  readingPath.length > 0 && (
    <section class="section profile-path" aria-labelledby="path-title">
      <div class="running-head home-head">
        <h2 class="home-head-title" id="path-title">
          {nums.readingPath && <span class="running-head-num">{nums.readingPath}</span>}
          <span lang="en">Reading Path</span>
        </h2>
        <p class="home-head-meta">
          <span>{String(readingPath.length).padStart(2, "0")}</span>
          <span lang="en">{readingPath.length === 1 ? "Stage" : "Stages"}</span>
        </p>
        <ol class="home-rail-index">
          {readingPath.map((r, i) => (
            <li>
              <a href={`#stage-${i + 1}`}>
                <span class="home-rail-num">{pad(i)}</span>
                <span>{r.stage}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
      <div class="section-body">
        <ol class="reading-path">
          {readingPath.map((r, i) => (
            <li class="reading-stage reveal" id={`stage-${i + 1}`}>
              <span class="reading-node" aria-hidden="true">
                <span class="reading-dot" />
                <span class="reading-num">{pad(i)}</span>
              </span>
              <div class="reading-text">
                <h3 class="reading-stage-name">{r.stage}</h3>
                <p class="reading-why">{r.why}</p>
              </div>
              <span class="reading-books">
                {r.slugs.map((slug) => (
                  <a
                    class="reading-cover"
                    href={bookUrl(slug)}
                    target="_blank"
                    rel="noopener"
                    title={titleBySlug.get(slug) ?? slug}
                  >
                    <img
                      class="cover-img reading-cover-img"
                      src={bookCoverUrl(slug)}
                      data-fallback={bookUrl(slug, "cover.png")}
                      alt={titleBySlug.get(slug) ?? slug}
                      loading="lazy"
                      decoding="async"
                      width="132"
                      height="190"
                    />
                  </a>
                ))}
              </span>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

{
  influences.length > 0 && (
    <section class="section profile-influences" aria-labelledby="influences-title">
      <div class="running-head home-head">
        <h2 class="home-head-title" id="influences-title">
          {nums.influences && <span class="running-head-num">{nums.influences}</span>}
          <span lang="en">Influences</span>
        </h2>
        <p class="home-head-meta">
          <span>{String(influences.length).padStart(2, "0")}</span>
          <span lang="en">{influences.length === 1 ? "Name" : "Names"}</span>
        </p>
      </div>
      <div class="section-body">
        <ul class="influences reveal">
          {influences.map((i) => (
            <li class="influence">
              {i.site ? (
                <a
                  class="influence-name is-linked"
                  href={siteUrl(i.site, "/")}
                  target="_blank"
                  rel="noopener"
                >
                  {i.name}
                </a>
              ) : (
                <span class="influence-name">{i.name}</span>
              )}
              <span class="influence-note">{i.note}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
