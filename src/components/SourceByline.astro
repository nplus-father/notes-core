---
import { bookUrl, splitBookLabel } from "../lib/links";
interface Item {
  book: string;
  label: string;
  anchor?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
const books = [...new Map(items.map((it) => [it.book, it])).values()];
const bookName = (label: string) => splitBookLabel(label).book || label.trim();
---

{
  books.length > 0 && (
    <div class="mg-block mg-from">
      <p class="mg-label">From</p>
      <ul class="mg-books">
        {books.map((it) => (
          <li>
            <a href={bookUrl(it.book)} target="_blank" rel="noopener">
              {bookName(it.label)}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
