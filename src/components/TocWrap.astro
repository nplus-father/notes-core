<script is:inline>
  (() => {
    const lines = [...document.querySelectorAll(".toc-line")];
    if (!lines.length) return;
    const wide = matchMedia("(min-width: 721px)");
    const measure = () => {
      for (const li of lines) li.classList.remove("is-wrapped", "is-split");
      if (!wide.matches) return;
      const lineH = (el) => parseFloat(getComputedStyle(el).lineHeight) || 24;
      const wrapped = lines.filter((li) => {
        const t = li.querySelector(".toc-t");
        const d = li.querySelector(".toc-dots");
        if (!t || !d) return false;
        return (
          t.getBoundingClientRect().height > lineH(t) * 1.5 || d.getBoundingClientRect().width < 20
        );
      });
      const split = wrapped.filter((li) => li.querySelector(".toc-en"));
      for (const li of split) li.classList.add("is-split");
      const still = wrapped.filter((li) => {
        if (!li.classList.contains("is-split")) return true;
        const m = li.querySelector(".toc-main");
        const d = li.querySelector(".toc-dots");
        return (
          m.getBoundingClientRect().height > lineH(m) * 1.5 || d.getBoundingClientRect().width < 20
        );
      });
      for (const li of still) li.classList.add("is-wrapped");
    };
    let frame = 0;
    const schedule = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(measure);
    };
    addEventListener("resize", schedule);
    if (document.fonts) document.fonts.ready.then(schedule);
    measure();
  })();
</script>
