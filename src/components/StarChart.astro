---
import { getCollection } from "astro:content";
import { site } from "virtual:notes-core/site";
import { getCategories } from "../lib/nav-data";
import { bareSlug } from "../lib/collections";
import { withBase } from "../lib/url";
import { chapterNumbers, pad2 } from "../lib/toc";
import { layoutStarChart, type ChartCategoryInput, type ChartTier } from "../lib/star-chart";

const concepts = await getCollection("concepts");
const { categories } = await getCategories();

const writtenByCat = new Map<string, Map<string, (typeof concepts)[number]>>();
for (const c of concepts) {
  const cat = c.data.category;
  if (!writtenByCat.has(cat)) writtenByCat.set(cat, new Map());
  writtenByCat.get(cat)!.set(bareSlug(c.id), c);
}
const numbers = chapterNumbers(
  categories as any[],
  (slug) => (writtenByCat.get(slug)?.size ?? 0) > 0
);

const input: ChartCategoryInput[] = [...categories]
  .sort((a: any, b: any) => a.order - b.order)
  .filter((c: any) => numbers.has(c.slug))
  .map((c: any) => {
    const written = writtenByCat.get(c.slug) ?? new Map();
    const seen = new Set<string>();
    const pages = (c.roadmap ?? []).map((n: any) => {
      seen.add(n.slug);
      const entry = written.get(n.slug);
      return {
        slug: n.slug,
        title: entry?.data.title ?? n.title ?? n.slug,
        href: entry ? withBase(`concepts/${entry.id}/`) : null,
        tier: (n.tier ?? "basic") as ChartTier,
        importance: entry?.data.importance ?? 2,
        written: !!entry,
        related: entry?.data.related ?? [],
      };
    });
    for (const [slug, entry] of written) {
      if (seen.has(slug)) continue;
      pages.push({
        slug,
        title: entry.data.title,
        href: withBase(`concepts/${entry.id}/`),
        tier: null,
        importance: entry.data.importance,
        written: true,
        related: entry.data.related,
      });
    }
    return { slug: c.slug, name: c.name, num: numbers.get(c.slug)!, pages };
  });

const chart = layoutStarChart({ seed: site.brand, categories: input });
const f = chart?.furniture;
const station = site.brand;
const starsLabel = (n: number) => `${n} ${n === 1 ? "star" : "stars"}`;
const cstLabel = (n: number) => `${n} ${n === 1 ? "constellation" : "constellations"}`;
const byK = chart ? chart.labels.map((l) => chart.stars.filter((s) => s.k === l.k)) : [];
const segByK = chart ? chart.labels.map((l) => chart.segments.filter((s) => s.k === l.k)) : [];
const rayD = new Map(f?.rays.map((r) => [r.mag, r.d]) ?? []);
const nameOf = (k: number) => input[k]?.name ?? "";
const tagsByK = chart
  ? chart.labels.map((l) => [
      ...chart.tags.filter((t) => t.k === l.k).map((t) => ({ t, m: false })),
      ...chart.mobileTags.filter((t) => t.k === l.k).map((t) => ({ t, m: true })),
    ])
  : [];
---

{
  chart && f && (
    <script is:inline>
      try {
        if (sessionStorage.getItem("sc-seen")) document.documentElement.classList.add("sc-seen");
        else sessionStorage.setItem("sc-seen", "1");
      } catch {}
    </script>
  )
}
{
  chart && f && (
    <figure
      class:list={["sc", { "has-abbr": chart.abbreviated, "is-sparse": chart.sparse }]}
      aria-labelledby="sc-cap"
    >
      <div class="sc-plate">
        <svg
          class="sc-svg"
          viewBox={`0 0 ${f.size} ${f.size}`}
          role="group"
          style={chart.labelScale < 1 ? `--ls:${chart.labelScale}` : undefined}
          aria-label={`Star chart of ${station}: ${starsLabel(chart.counts.stars)} in ${cstLabel(chart.counts.constellations)}`}
        >
          <defs>
            {chart.labels.flatMap((l) => l.lines.map((ln) => <path id={ln.id} d={ln.d} />))}
            {chart.labels.map((l) => l.mobile && <path id={l.mobile.id} d={l.mobile.d} />)}
          </defs>
          <g class="sc-furn" aria-hidden="true">
            <circle class="sc-rim" cx={f.c} cy={f.c} r={f.rOuter} />
            <circle class="sc-rim-in" cx={f.c} cy={f.c} r={f.rTick} />
            <circle class="sc-tick sc-tick-1" cx={f.c} cy={f.c} r={f.rOuter - 3} pathLength="360" />
            <circle class="sc-tick sc-tick-5" cx={f.c} cy={f.c} r={f.rOuter - 5} pathLength="72" />
            <circle class="sc-tick sc-tick-10" cx={f.c} cy={f.c} r={f.rOuter - 8} pathLength="36" />
            <circle class="sc-field-rim" cx={f.c} cy={f.c} r={f.rField} />
            {f.declination.map((r) => (
              <circle class="sc-dec" cx={f.c} cy={f.c} r={r} />
            ))}
            <path class="sc-hour" d={f.hours} />
            {f.boundaries && <path class="sc-bound" d={f.boundaries} />}
            {f.dividers && <path class="sc-div" d={f.dividers} />}
            <path class="sc-fs" d={f.fieldSmall} />
            <path class="sc-fl" d={f.fieldLarge} />
            <path
              class="sc-pole"
              d={`M${f.c - 9} ${f.c}H${f.c + 9}M${f.c} ${f.c - 9}V${f.c + 9}`}
            />
            <circle class="sc-pole" cx={f.c} cy={f.c} r="3.5" />
          </g>
          <g class="sc-x" aria-hidden="true">
            {chart.links.map((l) => (
              <path d={l.d} />
            ))}
          </g>
          {chart.labels.map((l) => (
            <g class="sc-cst" data-k={l.k}>
              <a class="sc-sector" href={`#${l.slug}`} tabindex="-1" aria-hidden="true">
                <path d={chart.sectors[l.k].d} />
              </a>
              <g class="sc-lines" aria-hidden="true">
                {segByK[l.k].map((s) => (
                  <path d={s.d} pathLength="1" style={`--d:${l.k * 70 + s.order * 45}ms`} />
                ))}
              </g>
              <a
                class:list={["sc-name", { "has-m": l.mobile }]}
                href={`#${l.slug}`}
                aria-label={`${pad2(l.num)} ${nameOf(l.k)}`}
              >
                {(l.fits ? l.lines : l.lines.slice(0, 1)).map((ln, j) => (
                  <text class:list={["sc-label", { "is-latin": l.latin }]}>
                    <textPath href={`#${ln.id}`} startOffset="50%">
                      {j === 0 && <tspan class="sc-label-num">{pad2(l.num)}</tspan>}
                      {l.fits && (
                        <tspan class="sc-label-name" dx={j === 0 ? 4 : undefined}>
                          {` ${ln.text}`}
                        </tspan>
                      )}
                    </textPath>
                  </text>
                ))}
                {l.mobile && (
                  <text class:list={["sc-label-m", { "is-latin": l.latin }]}>
                    <textPath href={`#${l.mobile.id}`} startOffset="50%">
                      <tspan class="sc-label-num">{pad2(l.num)}</tspan>
                      <tspan class="sc-label-name" dx="6">
                        {` ${l.text}`}
                      </tspan>
                    </textPath>
                  </text>
                )}
                <text class="sc-numl" x={l.numX} y={l.numY}>
                  {pad2(l.num)}
                </text>
              </a>
              {chart.bayer
                .filter((b) => chart.stars[b.i].k === l.k)
                .map((b) => (
                  <text class="sc-bayer" x={b.x} y={b.y} aria-hidden="true">
                    {b.letter}
                  </text>
                ))}
              {byK[l.k].map((s) =>
                s.href ? (
                  <a
                    class:list={["sc-star", `m${s.mag}`, { "is-alpha": s.alpha }]}
                    href={s.href}
                    transform={`translate(${s.x} ${s.y})`}
                    style={`--d:${(5 - s.mag) * 160 + s.k * 30}ms`}
                  >
                    <title>{s.title}</title>
                    <circle class="sc-hit" r={s.hit} />
                    <circle class="sc-ring" r={Math.min(s.hit, s.r + 6)} />
                    <circle class="sc-dot" r={s.r} />
                    {s.mag >= 4 && <path class="sc-rays" d={rayD.get(s.mag)} />}
                  </a>
                ) : (
                  <g
                    class="sc-star is-planned"
                    transform={`translate(${s.x} ${s.y})`}
                    style={`--d:${900 + s.k * 30}ms`}
                  >
                    <title>{`${s.title} (planned)`}</title>
                    <circle class="sc-hit" r={s.hit} />
                    <circle class="sc-dot" r={s.r} />
                  </g>
                )
              )}
            </g>
          ))}
          <g class="sc-tags" aria-hidden="true">
            {chart.labels.map((l) =>
              tagsByK[l.k].map(({ t, m }) => (
                <g
                  class:list={["sc-tag", m ? "is-m" : "is-d"]}
                  data-k={l.k}
                  style={`--d:${1300 + l.k * 70}ms`}
                >
                  {t.leader && <path class="sc-tag-lead" d={t.leader} />}
                  <text
                    class:list={["sc-tag-t", { "is-latin": t.latin }]}
                    x={t.x}
                    y={t.y}
                    text-anchor={t.anchor}
                    font-size={t.size}
                  >
                    {t.lines.map((ln, j) => (
                      <tspan x={t.x} dy={j === 0 ? `${-(t.lines.length - 1) * 0.61}em` : "1.22em"}>
                        {ln}
                      </tspan>
                    ))}
                  </text>
                </g>
              ))
            )}
          </g>
        </svg>
        <span class="sc-tip" aria-hidden="true" />
      </div>
      <div class="sc-side">
        <p class="sc-hint" lang="en">
          Tap a constellation to jump to its chapter
        </p>
        <div class="sc-cap" id="sc-cap">
          <span class="sc-cap-pl" lang="en">
            <span class="sc-cap-num">Pl. II</span>
            <span>Chart of {station}</span>
          </span>
          <span class="sc-cap-count" lang="en">
            {starsLabel(chart.counts.written)}
            {chart.counts.planned > 0 && <> · {chart.counts.planned} unlit</>} ·{" "}
            {cstLabel(chart.counts.constellations)}
          </span>
          {chart.bayer.length > 0 && (
            <ol class="sc-bright" aria-label="Brightest stars">
              {chart.bayer.map((b) => {
                const st = chart.stars[b.i];
                return (
                  <li>
                    <span class="sc-bright-l" aria-hidden="true">
                      {b.letter}
                    </span>
                    <a class="link-draw" href={st.href ?? undefined}>
                      {st.title}
                    </a>
                  </li>
                );
              })}
            </ol>
          )}
          <span class="sc-legend" lang="en" aria-hidden="true">
            <span class="sc-legend-t">Mag.</span>
            {[5, 4, 3, 2, 1].map((m) => (
              <span class="sc-legend-i">
                <svg viewBox="-12 -12 24 24" width="18" height="18">
                  <circle r={[0, 2.3, 3.2, 4.3, 5.7, 7.4][m]} />
                </svg>
                {m}
              </span>
            ))}
            {chart.counts.planned > 0 && (
              <span class="sc-legend-i is-planned">
                <svg viewBox="-12 -12 24 24" width="18" height="18">
                  <circle r="3.4" />
                </svg>
                Planned
              </span>
            )}
          </span>
        </div>
        <ol
          class:list={["sc-key", { "is-short": chart.labels.length <= 5 }]}
          aria-label="Chapters"
          style={`--rows:${Math.ceil(chart.labels.length / 2)}`}
        >
          {chart.labels.map((l) => (
            <li data-k={l.k}>
              <a href={`#${l.slug}`}>
                <span class="sc-key-num">{pad2(l.num)}</span>
                <span class="sc-key-name">{nameOf(l.k)}</span>
                <span class="sc-key-n">
                  {byK[l.k].length}
                  <span class="visually-hidden">{byK[l.k].length === 1 ? "page" : "pages"}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </figure>
  )
}

<script>
  for (const fig of document.querySelectorAll<HTMLElement>(".sc")) {
    const tip = fig.querySelector<HTMLElement>(".sc-tip");
    const svg = fig.querySelector<SVGSVGElement>(".sc-svg");
    if (!tip || !svg) continue;
    const show = (el: SVGGraphicsElement) => {
      const m = el.transform.baseVal.consolidate()?.matrix;
      if (!m) return;
      tip.textContent = el.querySelector("title")?.textContent ?? "";
      tip.style.left = `${m.e / 10}%`;
      tip.style.top = `${m.f / 10}%`;
      tip.classList.toggle("is-left", m.e > 640);
      tip.classList.add("is-on");
      svg.classList.add("is-hovering");
    };
    const hide = () => {
      tip.classList.remove("is-on");
      svg.classList.remove("is-hovering");
    };
    const pick = (e: Event) =>
      ((e.target as Element | null)?.closest?.(".sc-star") as SVGGraphicsElement | null) ?? null;
    svg.addEventListener("pointerover", (e) => {
      const s = pick(e);
      if (s) show(s);
    });
    svg.addEventListener("pointerout", (e) => {
      if (pick(e)) hide();
    });
    svg.addEventListener("focusin", (e) => {
      const s = pick(e);
      if (s) show(s);
    });
    svg.addEventListener("focusout", hide);
    const groups = new Map<string, Element[]>();
    for (const el of fig.querySelectorAll("[data-k]")) {
      const k = el.getAttribute("data-k")!;
      groups.set(k, [...(groups.get(k) ?? []), el]);
    }
    let hot: string | null = null;
    const heat = (k: string | null) => {
      if (k === hot) return;
      if (hot) for (const el of groups.get(hot) ?? []) el.classList.remove("is-hot");
      hot = k;
      if (k) for (const el of groups.get(k) ?? []) el.classList.add("is-hot");
      fig.toggleAttribute("data-hot", !!k);
    };
    const kOf = (e: Event) =>
      (e.target as Element | null)?.closest?.("[data-k]")?.getAttribute("data-k") ?? null;
    fig.addEventListener("pointerover", (e) => heat(kOf(e)));
    fig.addEventListener("pointerleave", () => heat(null));
    fig.addEventListener("focusin", (e) => heat(kOf(e)));
    fig.addEventListener("focusout", (e) => {
      if (!fig.contains((e as FocusEvent).relatedTarget as Node | null)) heat(null);
    });
  }
</script>
