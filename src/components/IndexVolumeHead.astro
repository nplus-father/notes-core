---
import { volume } from "../lib/vol";
import { site } from "virtual:notes-core/site";
import { withBase } from "../lib/url";

interface Props {
  page: string;
  num?: string;
  class?: string;
}
const { page, num, class: cls } = Astro.props;
const v = volume(site.titleBase ?? site.brand);
---

<p class:list={["vol-line running-head", cls]}>
  <span class="vol-swatch" aria-hidden="true"></span>
  {v.serial && <span class="vol-serial">{v.serial}</span>}
  <a class="vol-name" href={withBase("/")}>{v.label}</a>
  <span class="vol-page">
    {page}
    {num && <span class="idx-kicker-num">{num}</span>}
  </span>
</p>
{v.style && <style is:inline set:html={`:root{${v.style}}`} />}
