---
// 首頁「領域地圖」：主題站的領域鳥瞰——每張卡：主張、代表人物
// （有作者站就跨站連結）、對應的站內概念分類。人物站的對應物是 AuthorProfile。
// 資料由各站 src/data/schools.ts 提供（型別見 lib/library.ts）。
//
// 口味詞彙表（v0.19.0）：標題與副標由 kind 決定、收斂在這裡——站台只挑 enum、
// 不寫自由文字；要新口味改 core 一處，62 站一起變。
import { withBase } from "../lib/url";
import { siteUrl } from "../lib/links";
import type { SchoolsData, SchoolsKind } from "../lib/library";

interface Props {
  schools: SchoolsData;
}
const { schools: data } = Astro.props;
const schools = data.entries;

const KINDS: Record<SchoolsKind, { heading: string; note: string }> = {
  schools: { heading: "學派地圖", note: "這個領域的主要流派——各自的主張與代表人物" },
  methods: { heading: "方法地圖", note: "這個領域的主要方法體系——各自的切入點與代表人物" },
  themes: { heading: "主題地圖", note: "這個領域的核心命題——各自要回答的問題與代表人物" },
};
const { heading, note } = KINDS[data.kind] ?? KINDS.schools;
---

{
  schools.length > 0 && (
    <section class="schools">
      <div class="schools-head">
        <h2>{heading}</h2>
        <span class="schools-note">{note}</span>
      </div>
      {data.lede && <p class="schools-lede" set:html={data.lede} />}
      <div class="school-grid">
        {schools.map((s, i) => (
          <article class="school-card">
            <div class="school-head">
              {/* 序號記號取代各站 schools.ts 的 emoji 圖示（📜 ⚖️ 🏛 …）——與站縮圖
                  的 N° 同一個裝置，35 個主題站因此不必逐站改資料就一起變。
                  School.icon 已標 deprecated，這裡刻意不再渲染。 */}
              <span class="school-index">{String(i + 1).padStart(2, "0")}</span>
              <span class="school-name">{s.name}</span>
              {/* 卡片唯一的去處，所以做成鍵而不是一行小灰字——原本它只是右上角一句
                  「站內筆記 →」，跟卡片其他文字同色同粗細，看不出可以點。 */}
              {s.categorySlug && (
                <a class="school-cat" href={withBase(`/concepts/${s.categorySlug}/`)}>
                  站內筆記
                  <span class="school-cat-arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              )}
            </div>
            <p class="school-claim" set:html={s.claim} />
            {s.figures && s.figures.length > 0 && (
              <div class="school-figures">
                {s.figures.map((f) =>
                  f.site ? (
                    <a
                      class="school-figure is-linked"
                      href={siteUrl(f.site, "/")}
                      target="_blank"
                      rel="noopener"
                    >
                      {f.name}
                    </a>
                  ) : (
                    <span class="school-figure">{f.name}</span>
                  )
                )}
              </div>
            )}
          </article>
        ))}
      </div>
    </section>
  )
}
