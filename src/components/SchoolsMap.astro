---
import { withBase } from "../lib/url";
import { siteUrl } from "../lib/links";
import type { SchoolsData, SchoolsKind } from "../lib/library";

interface Props {
  schools: SchoolsData;
  num?: string;
}
const { schools: data, num = "" } = Astro.props;
const schools = data.entries;

const KINDS: Record<SchoolsKind, string> = {
  schools: "Schools",
  methods: "Methods",
  themes: "Themes",
};
const heading = KINDS[data.kind] ?? KINDS.schools;
---

{
  schools.length > 0 && (
    <section class="section is-wide schools" aria-labelledby="schools-title">
      <div class="running-head home-head">
        <h2 class="home-head-title" id="schools-title">
          {num && <span class="running-head-num">{num}</span>}
          <span lang="en">{heading}</span>
        </h2>
        <p class="home-head-meta">
          <span>{String(schools.length).padStart(2, "0")}</span>
          <span lang="en">{schools.length === 1 ? "Entry" : "Entries"}</span>
        </p>
      </div>
      <div class="section-body">
        {data.lede && <p class="schools-lede reveal" set:html={data.lede} />}
        <ol class="school-list">
          {schools.map((s, i) => (
            <li class="school-row reveal" id={`school-${i + 1}`}>
              <span class="school-num" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div class="school-main">
                <h3 class="school-name">{s.name}</h3>
                <p class="school-claim" set:html={s.claim} />
              </div>
              <div class="school-side">
                {s.figures && s.figures.length > 0 && (
                  <p class="school-figures">
                    <span class="school-side-label" lang="en">
                      Figures
                    </span>
                    <span class="school-figure-list">
                      {s.figures.map((f, j) => (
                        <>
                          {f.site ? (
                            <a
                              class="school-figure is-linked"
                              href={siteUrl(f.site, "/")}
                              target="_blank"
                              rel="noopener"
                            >
                              {f.name}
                            </a>
                          ) : (
                            <span class="school-figure">{f.name}</span>
                          )}
                          {j < s.figures!.length - 1 && <span class="school-sep">, </span>}
                        </>
                      ))}
                    </span>
                  </p>
                )}
                {s.categorySlug && (
                  <a
                    class="school-cat"
                    href={withBase(`/concepts/${s.categorySlug}/`)}
                    aria-label={`Notes · ${s.name}`}
                  >
                    <span lang="en">Notes</span>
                    <span class="arrow" aria-hidden="true">
                      →
                    </span>
                  </a>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}
