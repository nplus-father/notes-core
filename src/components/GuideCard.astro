---
// 首頁「導覽」入口（v0.30.0）：站上有 guide 內容時，在總覽之後給一張章節目錄——
// 總覽是三段散文的摘要，導覽是完整長文；這一格是兩者之間的「往深處讀」動線。
// 資料直接讀 guide collection（與 /guide/ 同源），站台不必接線。
import { withBase } from "../lib/url";
import { getCollection } from "astro:content";

const entries = (await getCollection("guide")).sort((a, b) => a.id.localeCompare(b.id));

const NUMS = ["一", "二", "三", "四", "五", "六", "七", "八", "九", "十"];
const numOf = (i: number) => NUMS[i] ?? String(i + 1);
const shortTitle = (t: string) => t.split("：")[0];
const writtenAt = entries.reduce<string>(
  (acc, e) => (e.data.writtenAt > acc ? e.data.writtenAt : acc),
  ""
);
---

{
  entries.length > 0 && (
    <section class="guidecard">
      <div class="guidecard-head">
        <h2>導覽</h2>
        <span class="guidecard-note">把這一站讀成一份長導讀——主線、經典書與讀法</span>
        {writtenAt && (
          <span class="guidecard-stamp" title="這份導覽依當時的站況寫成">
            {writtenAt}
          </span>
        )}
      </div>
      <ol class="guidecard-list">
        {entries.map((e, i) => (
          <li>
            <a href={withBase(`guide/#${e.id.replace(/^guide\//, "")}`)}>
              <span class="guidecard-num">第{numOf(i)}章</span>
              {shortTitle(e.data.title)}
            </a>
          </li>
        ))}
      </ol>
      <a class="guidecard-cta" href={withBase("guide/")}>
        從第一章開始讀 →
      </a>
    </section>
  )
}
