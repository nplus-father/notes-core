---
import BaseLayout from "./BaseLayout.astro";
import Crumbs from "../components/Crumbs.astro";
import Marginalia from "../components/Marginalia.astro";
import FurtherReading from "../components/FurtherReading.astro";
import SeeAlso from "../components/SeeAlso.astro";
import RelatedList from "../components/RelatedList.astro";
import PrevNext from "../components/PrevNext.astro";
import Kern from "../components/Kern.astro";
import ReadingScripts from "../components/ReadingScripts.astro";
import { withBase } from "../lib/url";
import { bareSlug, bySlug } from "../lib/collections";
import { splitTitle } from "../lib/reading";
import { stripEmoji, type SiteConfig } from "../lib/site-config";

interface Props {
  entry: any;
  allProblems: any[];
  allConcepts: any[];
  domainBySlug: Map<string, { slug: string; name: string; icon: string }>;
  categoryBySlug: Map<string, { icon: string; name?: string }>;
  site: SiteConfig;
  headings?: { depth: number; slug: string; text: string }[];
  standfirst?: string;
}
const {
  entry,
  allProblems,
  allConcepts,
  domainBySlug,
  categoryBySlug,
  site,
  headings = [],
  standfirst,
} = Astro.props;
const d = entry.data;
const domain = domainBySlug.get(d.domain);
const slug = bareSlug(entry.id);
const title = splitTitle(d.title);

const conceptBySlug = bySlug(allConcepts);
const practices = d.concepts.map((s: string) => {
  const t = conceptBySlug.get(s);
  const cat = t ? categoryBySlug.get(t.data.category) : undefined;
  return t
    ? {
        slug: s,
        title: t.data.title,
        href: withBase(`concepts/${t.id}/`),
        meta: cat?.name ? stripEmoji(cat.name) : undefined,
      }
    : { slug: s };
});

const problemBySlug = bySlug(allProblems);
const backlinks = allProblems
  .filter((p: any) => p.data.related.includes(slug) && !d.related.includes(bareSlug(p.id)))
  .map((p: any) => bareSlug(p.id));
const related = [...d.related, ...backlinks].map((s: string) => {
  const t = problemBySlug.get(s);
  return t
    ? {
        slug: s,
        title: t.data.title,
        href: withBase(`problems/${t.id}/`),
        meta: t.data.difficulty,
      }
    : { slug: s };
});

const sameDomain = allProblems
  .filter((p: any) => p.data.domain === d.domain)
  .sort((a: any, b: any) => a.data.title.localeCompare(b.data.title));
const idx = sameDomain.findIndex((p: any) => p.id === entry.id);
const prev = idx > 0 ? sameDomain[idx - 1] : null;
const next = idx >= 0 && idx < sameDomain.length - 1 ? sameDomain[idx + 1] : null;
const nav = (p: any) => ({ href: withBase(`problems/${p.id}/`), title: p.data.title });
const problemLabel = site.problemLabelEn ?? "Problems";
---

<BaseLayout
  title={`${d.title} · ${site.titleBase}${site.problemSuffix ?? "題"}`}
  site={site}
  description={standfirst}
  progress
>
  <Crumbs
    site={site}
    items={[
      { label: problemLabel, href: "/problems/" },
      domain
        ? { label: domain.name, icon: domain.icon, href: `/problems/${domain.slug}/` }
        : { label: d.domain },
    ]}
  />

  <div class="reading bleed" data-kind="problem">
    <header class="page-head reading-head">
      <h1 class="reading-title">
        <Kern text={title.main} />
        {
          title.latin && (
            <span class="title-latin" lang="en">
              <span class="visually-hidden">(</span>
              {title.latin}
              <span class="visually-hidden">)</span>
            </span>
          )
        }
      </h1>
    </header>

    <div class="reading-grid">
      <Marginalia
        furtherReading={d.furtherReading}
        importance={d.importance}
        status={d.status}
        headings={headings}
        difficulty={d.difficulty}
      />
      <div id="solution" class="reading-body prose" data-pagefind-body>
        <span class="pf-meta" data-pagefind-ignore data-pagefind-meta="title">{d.title}</span>
        <span class="pf-meta" data-pagefind-ignore data-pagefind-filter="Type">Problem</span>
        <span class="pf-meta" data-pagefind-ignore data-pagefind-filter="Difficulty"
          >{d.difficulty}</span
        >
        <span class="pf-meta" data-pagefind-ignore data-pagefind-filter="Domain"
          >{domain?.name ?? d.domain}</span
        >
        <slot />
      </div>
    </div>

    <div class="reading-end">
      <FurtherReading items={d.furtherReading} />
      <RelatedList heading="Concepts Practiced" items={practices} />
      <SeeAlso items={d.seeAlso} />
      <RelatedList heading="Related" items={related} />
    </div>

    <PrevNext
      prev={prev ? nav(prev) : null}
      next={next ? nav(next) : null}
      ariaLabel="Same domain"
      prevLabel="Previous"
      nextLabel="Next"
    />
  </div>
  <ReadingScripts />
</BaseLayout>
