---
import "../styles/global.scss";
import { getCollection } from "astro:content";
import { withBase } from "../lib/url";
// 人像 = 星系共用（single source of truth）：favicon 與左上回首頁共用同一張圖，
// 圖歸 notes-core 管，各站不另存。以 ?url 匯入 → Vite 產出帶站台 base 的雜湊 URL。
import faviconUrl from "../assets/favicon.png?url";
import { buildNav, DEFAULT_PARENT_SITE, type SiteConfig } from "../lib/site-config";
import { siteBySlug } from "../lib/sites";
interface Props {
  title: string;
  site: SiteConfig;
  /** 這一頁沒有實質內容（如尚未定義 mastery 的空檢核頁），不要讓搜尋引擎收錄。 */
  noindex?: boolean;
}
const { title, site, noindex = false } = Astro.props;
// 知識軸掛在 <html> 上，讓人物站的主色（暖褐）與其站縮圖同一階——顏色只在
// global.scss 分岔一次，元件不必知道自己在哪種站。registry 查不到就走主題站預設。
const stationSlug = import.meta.env.BASE_URL.replace(/^\/|\/$/g, "");
const axis = siteBySlug.get(stationSlug)?.axis ?? "topic";
// nav 統一由 core 生成：固定詞彙、只出 emoji（📖 🧠 📝 ✅ 🔍，hover 帶英文全名）。
// ✅ / 📖 只在站台真的有資料時出現——沒補 mastery／沒寫導覽的站不出空 tab。
const hasCheck = (await getCollection("categories")).some(
  (c) => ((c.data as { mastery?: unknown[] }).mastery ?? []).length > 0
);
const hasGuide = (await getCollection("guide")).length > 0;
const nav = buildNav(site, { hasCheck, hasGuide });
// 「回母站」連結：未設 → 預設連 nplus.wiki/notes/（各站零設定即有）；設 null 可隱藏。
// v0.20.0 起同時出現在 topnav 最左（往上一層）與頁尾——原本只在頁尾，讀者滑到底才看得到。
const parentSite = site.parentSite === undefined ? DEFAULT_PARENT_SITE : site.parentSite;
// 保養戳記：蓋過章的站在頁尾露出日期（日期本身就是時效訊號，舊了讀者自然看得出來）。
const curationLine = [
  site.curation?.checkedAt && `🩺 體檢 ${site.curation.checkedAt}`,
  site.curation?.enrichedAt && `✍️ 補齊 ${site.curation.enrichedAt}`,
]
  .filter(Boolean)
  .join(" · ");
---

<!doctype html>
<html lang="zh-Hant" data-axis={axis}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={faviconUrl} type="image/png" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <!-- 先於繪製設定主題，避免閃爍 -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const saved = localStorage.getItem("theme");
        const sys = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        root.dataset.theme = saved ?? sys;
      })();
    </script>
    {
      /* 選用：覆寫品牌主色。html:root 特異度高於 global.scss 的 :root，確保勝出（與注入順序無關）。 */
    }
    {
      site.accentOverride && (
        <style is:inline set:html={`html:root{--accent:${site.accentOverride}}`} />
      )
    }
  </head>
  <body>
    <nav class="topnav">
      {
        /* 左側 = 一條往上的路：‹ 筆記星系（跨站，回 nplus.wiki/notes/）｜ 人像（本站首頁）。
          站名仍不進 topnav——身分由人像＋首頁 hero 承擔，62 站的導覽列長得一模一樣。 */
      }
      <div class="topnav-left">
        {
          parentSite && (
            <a class="topnav-up" href={parentSite.href} title={`回 ${parentSite.label}`}>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path
                  d="M8.6 3.2 4.8 7l3.8 3.8"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <span class="topnav-up-label">{parentSite.short ?? parentSite.label}</span>
            </a>
          )
        }
        <a class="brand-avatar" href={withBase("/")} title={site.brand}>
          <img src={faviconUrl} alt={site.brand} width="30" height="30" />
        </a>
      </div>
      <div class="topnav-right">
        <span class="topnav-links">
          {
            nav.map((l) =>
              /^https?:\/\//.test(l.href) ? (
                <a
                  href={l.href}
                  target="_blank"
                  rel="noopener"
                  title={l.title}
                  aria-label={l.title}
                >
                  {l.label}
                </a>
              ) : (
                <a href={withBase(l.href)} title={l.title} aria-label={l.title}>
                  {l.label}
                </a>
              )
            )
          }
        </span>
        <button
          id="theme-toggle"
          class="theme-toggle"
          type="button"
          aria-label="Toggle dark / light"
        >
          {/* 極簡線性 icon 取代 🌙 / ☀️ emoji；currentColor 讓它跟著 --text-2 走。 */}
          <svg
            class="icon-light"
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M13.2 9.7A5.6 5.6 0 0 1 6.3 2.8a5.6 5.6 0 1 0 6.9 6.9Z"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linejoin="round"></path>
          </svg>
          <svg
            class="icon-dark"
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <circle cx="8" cy="8" r="3.1" stroke="currentColor" stroke-width="1.2"></circle>
            <path
              d="M8 1v1.8M8 13.2V15M1 8h1.8M13.2 8H15M3.1 3.1l1.3 1.3M11.6 11.6l1.3 1.3M12.9 3.1l-1.3 1.3M4.4 11.6l-1.3 1.3"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </nav>

    <main class="container">
      <slot />
    </main>

    <footer class="footer">
      <span>{site.footer ?? "© 2026 Andrew"}</span>
      {
        parentSite && (
          <>
            <span class="footer-sep" aria-hidden="true">
              ·
            </span>
            <a class="footer-home" href={parentSite.href}>
              {parentSite.label}
            </a>
          </>
        )
      }
      {
        curationLine && (
          <>
            <span class="footer-sep" aria-hidden="true">
              ·
            </span>
            <span class="footer-curation" title="本站最近一次全站體檢／內容補齊（/note-check）">
              {curationLine}
            </span>
          </>
        )
      }
    </footer>

    <script is:inline>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("theme", next);
      });
    </script>
  </body>
</html>
