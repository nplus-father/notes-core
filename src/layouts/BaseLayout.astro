---
import "../styles/global.scss";
import { withBase } from "../lib/url";
// favicon = 星系共用人像（single source of truth）：圖歸 notes-core 管，各站不另存。
// 以 ?url 匯入 → Vite 產出帶站台 base 的雜湊 URL；升 notes-core 版即全站同步。
import faviconUrl from "../assets/favicon.png?url";
import { buildNav, type SiteConfig } from "../lib/site-config";
import { siteBySlug } from "../lib/sites";
interface Props {
  title: string;
  site: SiteConfig;
}
const { title, site } = Astro.props;
// 知識軸掛在 <html> 上，讓人物站的主色（暖褐）與其站縮圖同一階——顏色只在
// global.scss 分岔一次，元件不必知道自己在哪種站。registry 查不到就走主題站預設。
const stationSlug = import.meta.env.BASE_URL.replace(/^\/|\/$/g, "");
const axis = siteBySlug.get(stationSlug)?.axis ?? "topic";
// nav 統一由 core 依 hasProblems 生成（英文、無首頁）；各站不再手寫。
const nav = buildNav(site);
// 頁尾「回母站」連結：未設 → 預設連 nplus.wiki 根（各站零設定即有）；設 null 可隱藏。
const parentSite =
  site.parentSite === undefined
    ? { href: "https://nplus.wiki/", label: "nplus.wiki 筆記星系" }
    : site.parentSite;
---

<!doctype html>
<html lang="zh-Hant" data-axis={axis}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={faviconUrl} type="image/png" />
    <title>{title}</title>
    <!-- 先於繪製設定主題，避免閃爍 -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const saved = localStorage.getItem("theme");
        const sys = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        root.dataset.theme = saved ?? sys;
      })();
    </script>
    {
      /* 選用：覆寫品牌主色。html:root 特異度高於 global.scss 的 :root，確保勝出（與注入順序無關）。 */
    }
    {
      site.accentOverride && (
        <style is:inline set:html={`html:root{--accent:${site.accentOverride}}`} />
      )
    }
  </head>
  <body>
    <nav class="topnav">
      <a class="brand" href={withBase("/")}>{site.brand}</a>
      <div class="topnav-right">
        <span class="topnav-links">
          {
            nav.map((l) =>
              /^https?:\/\//.test(l.href) ? (
                <a href={l.href} target="_blank" rel="noopener">
                  {l.label}
                </a>
              ) : (
                <a href={withBase(l.href)}>{l.label}</a>
              ),
            )
          }
        </span>
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark / light">
          {/* 極簡線性 icon 取代 🌙 / ☀️ emoji；currentColor 讓它跟著 --text-2 走。 */}
          <svg class="icon-light" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M13.2 9.7A5.6 5.6 0 0 1 6.3 2.8a5.6 5.6 0 1 0 6.9 6.9Z"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linejoin="round"
            />
          </svg>
          <svg class="icon-dark" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <circle cx="8" cy="8" r="3.1" stroke="currentColor" stroke-width="1.2" />
            <path
              d="M8 1v1.8M8 13.2V15M1 8h1.8M13.2 8H15M3.1 3.1l1.3 1.3M11.6 11.6l1.3 1.3M12.9 3.1l-1.3 1.3M4.4 11.6l-1.3 1.3"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linecap="round"
            />
          </svg>
        </button>
      </div>
    </nav>

    <main class="container">
      <slot />
    </main>

    <footer class="footer">
      <span>{site.footer ?? "© 2026 Andrew"}</span>
      {
        parentSite && (
          <>
            <span class="footer-sep" aria-hidden="true">
              ·
            </span>
            <a class="footer-home" href={parentSite.href}>
              {parentSite.label}
            </a>
          </>
        )
      }
    </footer>

    <script is:inline>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("theme", next);
      });
    </script>
  </body>
</html>
