---
import "@fontsource-variable/inter/wght.css";
import "@fontsource-variable/newsreader/wght.css";
import "@fontsource-variable/newsreader/wght-italic.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import "../styles/global.scss";
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import { getCollection } from "astro:content";
import { withBase } from "../lib/url";
// 人像 = 星系共用（single source of truth）：favicon 與左上回首頁是同一張人像，
// 圖歸 notes-core 管，各站不另存。以 ?url 匯入 → Vite 產出帶站台 base 的雜湊 URL。
import faviconUrl from "../assets/favicon.png?url";
import portraitUrl from "../assets/portrait-96.webp?url&no-inline";
import Icon from "../components/Icon.astro";
import { buildNav, DEFAULT_PARENT_SITE, type SiteConfig } from "../lib/site-config";
import { siteBySlug, topicSites, personSites } from "../lib/sites";
import { siteUrl } from "../lib/links";
import { coverPlateFor, stationHue, clothFor } from "../lib/cover-plate";
import { motifSvg } from "../lib/motifs";
import { bibliography } from "virtual:notes-core/site";
interface Props {
  title: string;
  site: SiteConfig;
  /** 這一頁沒有實質內容（如尚未定義 mastery 的空檢核頁），不要讓搜尋引擎收錄。 */
  noindex?: boolean;
  description?: string;
  progress?: boolean;
  themeColor?: { light: string; dark: string };
}
const {
  title,
  site,
  noindex = false,
  description,
  progress = false,
  themeColor,
} = Astro.props;
// 知識軸掛在 <html> 上，讓人物站的主色（暖褐）與其站縮圖同一階——顏色只在
// global.scss 分岔一次，元件不必知道自己在哪種站。registry 查不到就走主題站預設。
const stationSlug = import.meta.env.BASE_URL.replace(/^\/|\/$/g, "");
const station = siteBySlug.get(stationSlug);
const axis = station?.axis ?? "topic";
const hue = site.accentOverride ? undefined : stationHue(stationSlug);
const plate = coverPlateFor(stationSlug);
const cloth = clothFor(stationSlug);
const htmlStyle =
  [
    hue === undefined ? "" : `--station-hue: ${hue}`,
    cloth ? `--cloth-l: ${cloth.light}; --cloth-d: ${cloth.dark}` : "",
  ]
    .filter(Boolean)
    .join("; ") || undefined;
const hasCheck = (await getCollection("categories")).some(
  (c) => ((c.data as { mastery?: unknown[] }).mastery ?? []).length > 0
);
const hasGuide = (await getCollection("guide")).length > 0;
const hasLibrary = (bibliography as unknown[]).length > 0;
const pathname = Astro.url.pathname;
const nav = buildNav(site, { hasCheck, hasGuide, hasLibrary });
const navItems = nav.map((l) => {
  const external = /^https?:\/\//.test(l.href);
  const href = external ? l.href : withBase(l.href);
  const label = l.title && !/[\p{L}\p{N}]/u.test(l.label) ? l.title : l.label;
  const fullName = l.title && l.title !== label ? l.title : undefined;
  return {
    ...l,
    label,
    external,
    href,
    fullName,
    current: !external && pathname.startsWith(href),
  };
});
// 「回母站」連結：未設 → 預設連 nplus.wiki/notes/（各站零設定即有）；設 null 可隱藏。
// v0.20.0 起同時出現在 topnav 最左（往上一層）與頁尾——原本只在頁尾，讀者滑到底才看得到。
const parentSite = site.parentSite === undefined ? DEFAULT_PARENT_SITE : site.parentSite;

const pool = axis === "person" ? personSites : topicSites;
const volIdx = pool.findIndex((s) => s.slug === stationSlug);
const serialOf = (i: number) => `N°${String(i + 1).padStart(2, "0")}`;
const serial = volIdx >= 0 ? serialOf(volIdx) : "";
const prevVol = volIdx > 0 ? pool[volIdx - 1] : null;
const nextVol = volIdx >= 0 && volIdx < pool.length - 1 ? pool[volIdx + 1] : null;
const volumeName = station?.label ?? site.titleBase ?? site.brand;
const curation = [
  site.curation?.checkedAt && {
    icon: "checkup" as const,
    label: "Checked",
    date: site.curation.checkedAt,
    title: "本站最近一次全站體檢（/note-check）",
  },
  site.curation?.enrichedAt && {
    icon: "enrich" as const,
    label: "Enriched",
    date: site.curation.enrichedAt,
    title: "本站最近一次內容補齊（/note-check --enrich）",
  },
].filter(Boolean) as { icon: "checkup" | "enrich"; label: string; date: string; title: string }[];

const plain = (html: string) =>
  html
    .replaceAll("{base}", withBase("/"))
    .replace(/<[^>]+>/g, "")
    .replace(/\s+/g, " ")
    .trim();
const metaDescription = (() => {
  const text = plain(description ?? site.heroLede ?? site.tagline ?? "");
  return text.length > 160 ? `${text.slice(0, 157)}…` : text;
})();
const hasCover = existsSync(resolve("public/cover.png"));
const absolute = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const canonical = absolute(pathname);
const ogImage = hasCover ? absolute(withBase("/cover.png")) : undefined;
const THEME_COLOR = themeColor ?? { light: "#f6f3ec", dark: "#111013" };
---

<!doctype html>
<html
  lang="zh-Hant"
  data-axis={axis}
  data-station-hue={hue}
  style={htmlStyle}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={faviconUrl} type="image/png" />
    {Astro.site && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    {Astro.site && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="900" />}
    {ogImage && <meta property="og:image:height" content="1200" />}
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content={THEME_COLOR.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={THEME_COLOR.dark} media="(prefers-color-scheme: dark)" />
    <!-- 先於繪製設定主題，避免閃爍 -->
    <script is:inline define:vars={{ THEME_COLOR }}>
      (() => {
        const root = document.documentElement;
        const saved = localStorage.getItem("theme");
        const sys = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        root.dataset.theme = saved ?? sys;
        document
          .querySelectorAll('meta[name="theme-color"]')
          .forEach((m) => m.setAttribute("content", THEME_COLOR[root.dataset.theme]));
      })();
    </script>
    {
      /* 選用：覆寫品牌主色。html:root 特異度高於 global.scss 的 :root，確保勝出（與注入順序無關）。 */
    }
    {
      site.accentOverride && (
        <style is:inline set:html={`html:root{--accent:${site.accentOverride}}`} />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">跳到內容</a>
    <nav class="topnav">
      <div class="topnav-left">
        {
          parentSite && (
            <a class="topnav-up" href={parentSite.href} title={`回 ${parentSite.label}`}>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path
                  d="M8.6 3.2 4.8 7l3.8 3.8"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <span class="topnav-up-label">{parentSite.short ?? parentSite.label}</span>
            </a>
          )
        }
        <a class="brand-avatar" href={withBase("/")} title={site.brand}>
          <img src={portraitUrl} alt={site.brand} width="30" height="30" />
        </a>
      </div>
      <ul class="topnav-links" id="topnav-links">
        {
          navItems.map((l) => (
            <li>
              <a
                class="topnav-link"
                href={l.href}
                target={l.external ? "_blank" : undefined}
                rel={l.external ? "noopener" : undefined}
                title={l.fullName}
                aria-label={l.fullName}
                aria-current={l.current ? "page" : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark / light">
        <svg
          class="icon-light"
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M13.2 9.7A5.6 5.6 0 0 1 6.3 2.8a5.6 5.6 0 1 0 6.9 6.9Z"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linejoin="round"></path>
        </svg>
        <svg
          class="icon-dark"
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <circle cx="8" cy="8" r="3.1" stroke="currentColor" stroke-width="1.2"></circle>
          <path
            d="M8 1v1.8M8 13.2V15M1 8h1.8M13.2 8H15M3.1 3.1l1.3 1.3M11.6 11.6l1.3 1.3M12.9 3.1l-1.3 1.3M4.4 11.6l-1.3 1.3"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </nav>
    <script is:inline>
      (() => {
        const list = document.getElementById("topnav-links");
        if (!list) return;
        const active = list.querySelector('[aria-current="page"]');
        if (active && list.scrollWidth > list.clientWidth) {
          const lr = list.getBoundingClientRect();
          const ar = active.getBoundingClientRect();
          list.scrollLeft += ar.left - lr.left - (list.clientWidth - ar.width) / 2;
        }
        const fade = () => {
          list.toggleAttribute("data-more-start", list.scrollLeft > 2);
          list.toggleAttribute(
            "data-more-end",
            list.scrollLeft + list.clientWidth < list.scrollWidth - 2
          );
        };
        fade();
        list.addEventListener("scroll", fade, { passive: true });
        window.addEventListener("resize", fade, { passive: true });
      })();
    </script>
    {progress && <div class="reading-progress" aria-hidden="true" />}

    <main id="main" class="container" tabindex="-1">
      <slot />
    </main>

    <footer class="colophon">
      <div class="colophon-inner">
        <div class:list={["colophon-title", { "has-mark": !!cloth }]}>
          {
            cloth && (
              <span class:list={["colophon-mark", { "is-numeral": !plate }]} aria-hidden="true">
                {plate ? (
                  <Fragment
                    set:html={motifSvg(plate.motif, { className: "colophon-motif", stroke: 5, fit: true })}
                  />
                ) : (
                  <span class="colophon-mark-num">{serial}</span>
                )}
              </span>
            )
          }
          <p class="running-head">
            {serial && <span class="running-head-num">{serial}</span>}
            <span>{axis === "person" ? "Person" : "Topic"}</span>
          </p>
          <p class="colophon-name">{volumeName}</p>
          <p class="colophon-brand label">{site.brand}</p>
        </div>
        {
          curation.length > 0 && (
            <div class="colophon-care">
              <p class="running-head">Upkeep</p>
              <ul>
                {curation.map((c) => (
                  <li title={c.title}>
                    <Icon name={c.icon} size={18} />
                    <span>{c.label}</span>
                    <time datetime={c.date}>{c.date}</time>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          (prevVol || nextVol || parentSite) && (
            <nav class="colophon-vols" aria-label="Volumes">
              <p class="running-head">Volumes</p>
              <ul>
                {prevVol && (
                  <li>
                    <a class="colophon-vol-prev" href={siteUrl(prevVol.key)} rel="prev">
                      <Icon name="arrow-left" size={18} />
                      <span class="colophon-vol-num">{serialOf(volIdx - 1)}</span>
                      <span class="colophon-vol-name">{prevVol.label}</span>
                    </a>
                  </li>
                )}
                {nextVol && (
                  <li>
                    <a class="colophon-vol-next" href={siteUrl(nextVol.key)} rel="next">
                      <span class="colophon-vol-num">{serialOf(volIdx + 1)}</span>
                      <span class="colophon-vol-name">{nextVol.label}</span>
                      <Icon name="arrow-right" size={18} />
                    </a>
                  </li>
                )}
                {parentSite && (
                  <li>
                    <a class="colophon-vol-up" href={parentSite.href}>
                      <span class="colophon-vol-name">{parentSite.label}</span>
                      <Icon name="arrow-up-right" size={18} />
                    </a>
                  </li>
                )}
              </ul>
            </nav>
          )
        }
      </div>
      <div class="colophon-base">
        <span
          ><span class="colophon-seal" aria-hidden="true"></span>{
            site.footer ?? "© 2026 Andrew"
          }</span
        >
        <span>Set in Newsreader, Inter &amp; JetBrains Mono; Chinese in the system serif &amp; sans</span>
      </div>
    </footer>

    <script is:inline define:vars={{ THEME_COLOR }}>
      const ACTIVE = '[aria-current], [aria-selected="true"], .is-active';
      const reveal = (el) => {
        const a = el.querySelector(ACTIVE);
        if (!a || el.scrollWidth <= el.clientWidth) return;
        const box = el.getBoundingClientRect();
        const r = a.getBoundingClientRect();
        const pad = 40;
        if (r.left < box.left + pad) el.scrollLeft += r.left - box.left - pad;
        else if (r.right > box.right - pad) el.scrollLeft += r.right - box.right + pad;
      };
      for (const el of document.querySelectorAll("[data-edge-fade]")) {
        const cut = () => {
          const max = el.scrollWidth - el.clientWidth;
          const at = el.scrollLeft;
          el.dataset.cut = [max > 2 && at > 2 && "start", max > 2 && at < max - 2 && "end"]
            .filter(Boolean)
            .join(" ");
        };
        reveal(el);
        cut();
        el.addEventListener("scroll", cut, { passive: true });
        addEventListener("resize", cut, { passive: true });
        new MutationObserver(() => {
          reveal(el);
          cut();
        }).observe(el, {
          subtree: true,
          attributes: true,
          attributeFilter: ["aria-current", "aria-selected", "class", "hidden"],
        });
      }
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("theme", next);
        document
          .querySelectorAll('meta[name="theme-color"]')
          .forEach((m) => m.setAttribute("content", THEME_COLOR[next]));
      });
    </script>
  </body>
</html>
