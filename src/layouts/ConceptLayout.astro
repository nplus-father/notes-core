---
import BaseLayout from "./BaseLayout.astro";
import Crumbs from "../components/Crumbs.astro";
import Marginalia from "../components/Marginalia.astro";
import FurtherReading from "../components/FurtherReading.astro";
import SeeAlso from "../components/SeeAlso.astro";
import RelatedList from "../components/RelatedList.astro";
import Kern from "../components/Kern.astro";
import VolumeHead from "../components/VolumeHead.astro";
import VolumeColophon from "../components/VolumeColophon.astro";
import ChapterPlate from "../components/ChapterPlate.astro";
import Endpaper from "../components/Endpaper.astro";
import ReadingScripts from "../components/ReadingScripts.astro";
import { withBase } from "../lib/url";
import { bareSlug, bySlug, byImportance } from "../lib/collections";
import { splitTitle } from "../lib/reading";
import { stripEmoji, type SiteConfig } from "../lib/site-config";
import { chapterNumbers } from "../lib/toc";
import { folioFor, chapterPrefix, sourceBooks } from "../lib/folio";

interface Props {
  entry: any;
  allConcepts: any[];
  allProblems: any[];
  categoryBySlug: Map<string, { slug: string; name: string; icon: string; order: number }>;
  site: SiteConfig;
  headings?: { depth: number; slug: string; text: string }[];
  standfirst?: string;
}
const {
  entry,
  allConcepts,
  allProblems,
  categoryBySlug,
  site,
  headings = [],
  standfirst,
} = Astro.props;
const d = entry.data;
const cat = categoryBySlug.get(d.category);
const slug = bareSlug(entry.id);
const title = splitTitle(d.title);

const conceptBySlug = bySlug(allConcepts);
const backlinks = allConcepts
  .filter((c: any) => c.data.related.includes(slug) && !d.related.includes(bareSlug(c.id)))
  .map((c: any) => bareSlug(c.id));
const categoryName = (s: string) => {
  const name = categoryBySlug.get(s)?.name;
  return name ? stripEmoji(name) : undefined;
};
const related = [...d.related, ...backlinks].map((s: string) => {
  const t = conceptBySlug.get(s);
  return t
    ? {
        slug: s,
        title: t.data.title,
        href: withBase(`concepts/${t.id}/`),
        meta: t.data.category === d.category ? undefined : categoryName(t.data.category),
      }
    : { slug: s };
});

const problemBySlug = bySlug(allProblems);
const usedBy = d.problems.map((s: string) => {
  const t = problemBySlug.get(s);
  return t
    ? {
        slug: s,
        title: t.data.title,
        href: withBase(`problems/${t.id}/`),
        meta: t.data.difficulty,
      }
    : { slug: s };
});

const sameCat = allConcepts.filter((c: any) => c.data.category === d.category).sort(byImportance);
const idx = sameCat.findIndex((c: any) => c.id === entry.id);
const prev = idx > 0 ? sameCat[idx - 1] : null;
const next = idx >= 0 && idx < sameCat.length - 1 ? sameCat[idx + 1] : null;
const nav = (c: any) => ({ href: withBase(`concepts/${c.id}/`), title: c.data.title });

const cats = [...categoryBySlug.values()];
const chapters = chapterNumbers(cats, (s) => allConcepts.some((c: any) => c.data.category === s));
const volume = cats
  .filter((c) => chapters.has(c.slug))
  .sort((a, b) => a.order - b.order)
  .flatMap((c) => allConcepts.filter((x: any) => x.data.category === c.slug).sort(byImportance));
const folio = folioFor({
  entry,
  unit: "Chapter",
  num: chapters.get(d.category) ?? 0,
  name: stripEmoji(cat?.name ?? d.category),
  href: cat ? `/concepts/${cat.slug}/` : "/concepts/",
  siblings: sameCat,
  volume,
});
---

<BaseLayout
  title={`${d.title} · ${site.titleBase}${site.conceptSuffix ?? "概念"}`}
  site={site}
  description={standfirst}
  progress
>
  <Crumbs
    site={site}
    items={[
      { label: site.conceptLabelEn ?? "Concepts", href: "/concepts/" },
      cat
        ? { label: cat.name, icon: cat.icon, href: `/concepts/${cat.slug}/` }
        : { label: d.category },
    ]}
  />

  <div
    class="reading bleed"
    data-kind={d.kind}
    style={chapterPrefix(folio)}
    data-folio
    data-ch={folio.num > 0 ? "" : undefined}
  >
    <header class="page-head reading-head">
      <VolumeHead
        section={cat?.name ?? d.category}
        sectionHref={cat ? `/concepts/${cat.slug}/` : "/concepts/"}
      />
      <ChapterPlate folio={folio} />
      {
        d.kind === "debate" && (
          <p class="reading-kicker running-head">
            <span class="seal" aria-hidden="true" />
            <span>Debate</span>
          </p>
        )
      }
      <h1 class="reading-title">
        <Kern text={title.main} />
        {
          title.latin && (
            <span class="title-latin" lang="en">
              <span class="visually-hidden">(</span>
              {title.latin}
              <span class="visually-hidden">)</span>
            </span>
          )
        }
      </h1>
    </header>

    <div class="reading-grid">
      <Marginalia
        furtherReading={d.furtherReading}
        importance={d.importance}
        status={d.status}
        headings={headings}
      />
      <div class="reading-body prose" data-pagefind-body>
        <span class="pf-meta" data-pagefind-ignore data-pagefind-meta="title">{d.title}</span>
        {site.hasProblems && <span class="pf-meta" data-pagefind-ignore data-pagefind-filter="Type">Concept</span>}
        <span class="pf-meta" data-pagefind-ignore data-pagefind-filter="Category">{cat?.name ?? d.category}</span>
        <slot />
      </div>
    </div>

    <div class="reading-end">
      <FurtherReading items={d.furtherReading} />
      <SeeAlso items={d.seeAlso} />
      <RelatedList heading="Problems using this" items={usedBy} />
      <RelatedList heading="Related" items={related} />
    </div>

    <VolumeColophon site={site} folio={folio} books={sourceBooks(d.furtherReading)} />
  </div>
  <ReadingScripts />
  <Endpaper
    slot="after"
    folio={folio}
    prev={prev ? nav(prev) : null}
    next={next ? nav(next) : null}
    ariaLabel="Same category"
  />
</BaseLayout>
